---
import '../styles/global.css';
const { title = 'JJ House — Director · Producer · VFX + Edit', desc = 'JJ House: Director, Producer, VFX + Edit. Multidisciplinary creative.', bare = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const sectionKey = {'/director':'director','/producer':'producer','/vfx-edit':'vfx','/for-fun':'fun'}[path];
const nav = [
  ['/director', 'Director'],
  ['/producer', 'Producer'],
  ['/vfx-edit', 'VFX + Edit'],
  ['/for-fun', 'For Fun'],
];
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={desc} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#10142e" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;1,9..144,300&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@400;600;700&display=swap" rel="stylesheet" />
  </head>
  <body class={bare ? 'landing' : undefined}>
    {!bare && (
      <header class="site-nav">
        <a class="brand" href="/">JJ HOUSE</a>
        <nav>
          {nav.map(([href, label]) => (
            <a href={href} aria-current={path === href ? 'page' : undefined}>{label}</a>
          ))}
          <a href="mailto:jj@jjhouse.me">Contact</a>
        </nav>
      </header>
    )}
    <main>
      <slot />
    </main>
    {!bare && (
      <footer class="footer">
        <div class="wrap">
          <span>© {year} JJ House</span>
          <span style="display:flex;gap:18px;flex-wrap:wrap">
            <a href="https://www.imdb.com/name/nm7420692/" target="_blank" rel="noopener">IMDb</a>
            <a href="https://www.instagram.com/jj.duplex/" target="_blank" rel="noopener">Instagram</a>
            <a href="mailto:jj@jjhouse.me">jj@jjhouse.me</a>
          </span>
        </div>
      </footer>
    )}
    {sectionKey && <script is:inline set:html={`(function(){try{var m=document.cookie.match(/jjvisits=([^;]+)/);var o={};if(m){decodeURIComponent(m[1]).split(',').forEach(function(p){var a=p.split(':');if(a[0])o[a[0]]=parseInt(a[1])||0;});}var k=${JSON.stringify(sectionKey)};o[k]=(o[k]||0)+1;document.cookie='jjvisits='+encodeURIComponent(Object.keys(o).map(function(x){return x+':'+o[x];}).join(','))+';path=/;max-age=31536000';}catch(e){}})();`} />}
  </body>
</html>
