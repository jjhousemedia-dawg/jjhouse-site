<style is:global>
    *{margin:0;padding:0;box-sizing:border-box}
    html,body{height:100%;background:#0b0d12;overflow:hidden;font-family:Georgia,'Times New Roman',serif;color:#f3ece0}
        #stage{position:fixed;inset:0;cursor:grab;touch-action:none}
    #stage, #stage *{ -webkit-user-select:none; user-select:none; -webkit-touch-callout:none; -webkit-tap-highlight-color:transparent; }
    #stage img{ -webkit-user-drag:none; }
    #fmtcard{ position:fixed; left:50%; bottom:62px; transform:translateX(-50%); z-index:6; display:none; align-items:center; gap:7px; padding:7px 14px; background:rgba(14,12,10,.82); border:1px solid rgba(230,184,115,.45); border-radius:6px; color:#e6b873; font-family:var(--mono),monospace; font-size:12px; letter-spacing:.14em; text-transform:uppercase; cursor:pointer; box-shadow:0 0 16px rgba(230,184,115,.16) }
    #fmtcard.show{ display:inline-flex }
    #fmtcard:hover{ background:rgba(30,25,18,.9); color:#f2d0a0 }
    #fmtcard b{ font-size:14px; line-height:1 }
    #stage canvas{display:block}
    .ov{position:fixed;left:42px;top:34px;z-index:5;pointer-events:none;mix-blend-mode:screen;opacity:.94}
    .ov .n{font-size:46px;letter-spacing:.06em}
    .ov .s{font-size:16px;font-style:italic;opacity:.8;margin-top:2px}
    .hint{position:fixed;left:0;right:0;bottom:26px;text-align:center;z-index:5;font-style:italic;font-size:14px;opacity:.7;pointer-events:none}
    .tag{position:fixed;right:14px;top:12px;z-index:5;font-family:var(--mono),monospace;font-size:11px;letter-spacing:.12em;opacity:.5}
    #flash{position:fixed;inset:0;z-index:9;background:#fff;opacity:0;pointer-events:none}
    #flash.on{opacity:1;transition:opacity .14s ease-out}
    #postit{position:fixed;left:24px;bottom:24px;z-index:7;width:216px;aspect-ratio:2160/2048;transform:rotate(-3deg);filter:drop-shadow(0 10px 20px rgba(0,0,0,.42))}
    #postit .pi-base{position:absolute;inset:0;width:100%;height:100%;display:block;pointer-events:none}
    #postit .pi-el{position:absolute;opacity:0;transition:opacity .3s ease;pointer-events:none}
    #postit .pi-el.show{opacity:1}
    #postit .pi-row{position:absolute;left:0;width:100%;display:block;cursor:pointer}
    #bars{position:fixed;inset:0;z-index:8;pointer-events:none}
    #bars i{position:absolute;left:0;right:0;height:12vh;background:#000;transition:transform .55s cubic-bezier(.7,0,.3,1)}
    #bars .bt{top:0;transform:translateY(-100%)}
    #bars .bb{bottom:0;transform:translateY(100%)}
    #bars.on .bt,#bars.on .bb{transform:translateY(0)}
    #slate{position:fixed;left:50%;top:14vh;transform:translateX(-50%);z-index:9;font-family:var(--mono),monospace;font-size:13px;letter-spacing:.2em;color:#fff;background:rgba(0,0,0,.55);border:1px solid rgba(255,255,255,.35);padding:8px 16px;border-radius:3px;opacity:0;transition:opacity .3s;pointer-events:none}
    #slate.on{opacity:1}
    @media (max-width:640px){
      .ov{left:16px;top:14px}
      .ov .n{font-size:30px}
      .ov .s{font-size:12px}
      #postit{width:186px;left:12px;bottom:14px}
      .hint{font-size:11px;bottom:auto;top:56px}
      .tag{display:none}
      #fmtcard{bottom:auto;top:14px;left:auto;right:12px;transform:none}
    }
  
    .ov .n,.ov .s{font-family:var(--serif),Georgia,serif}
    .hint{font-family:var(--serif),Georgia,serif}
    /* REEL escape hatch — one click to the work, always visible */
    #reelbtn{position:fixed;right:22px;top:20px;z-index:7;background:rgba(14,12,10,.6);border:1px solid rgba(230,184,115,.5);
      color:#e6b873;font-family:var(--mono),monospace;font-size:12px;letter-spacing:.18em;padding:9px 16px;border-radius:5px;cursor:pointer;backdrop-filter:blur(6px)}
    #reelbtn:hover{background:rgba(30,25,18,.85);color:#f2d0a0}
    #reelbox{position:fixed;inset:0;z-index:40;background:rgba(8,7,10,.9);backdrop-filter:blur(8px);display:none;align-items:center;justify-content:center}
    #reelbox.on{display:flex}
    #reelbox .rb-f{position:relative;width:min(92vw,1100px);aspect-ratio:16/9}
    #reelbox iframe{position:absolute;inset:0;width:100%;height:100%;border:0;border-radius:10px;background:#000}
    #reelx{position:fixed;top:20px;right:24px;z-index:41;background:transparent;border:1px solid rgba(255,255,255,.3);color:#fff;width:42px;height:42px;border-radius:50%;font-size:16px;cursor:pointer}
    /* custom viewfinder cursor */
    @media (pointer:fine){
      #stage,#stage a,#stage button{cursor:none}
      #cur{position:fixed;left:0;top:0;z-index:60;width:34px;height:34px;margin:-17px 0 0 -17px;border:1.5px solid rgba(243,236,224,.95);
        border-radius:50%;pointer-events:none;opacity:0;transition:transform .18s ease,opacity .3s;mix-blend-mode:difference}
      #cur i{position:absolute;left:50%;top:50%;width:4px;height:4px;margin:-2px 0 0 -2px;background:#ff3b30;border-radius:50%}
      #cur.on{opacity:1}
      #cur.big{transform:scale(1.8)}
    }
    @media (pointer:coarse){ #cur{display:none} }
    /* keyboard focus + fallback when WebGL is unavailable */
    .pi-row:focus-visible,#reelbtn:focus-visible,#fmtcard:focus-visible{outline:2px solid #e6b873;outline-offset:2px}
    html.no3d #stage{background:linear-gradient(180deg,#2e6f8e 0%,#7fb3bd 55%,#f0e9d4 100%)}
    html.no3d #cur{display:none}
    html.no3d #stage,html.no3d #stage a{cursor:auto}</style>

<script>
  import * as THREE from 'three';
  import { EffectComposer, RenderPass, EffectPass, BloomEffect, NoiseEffect, VignetteEffect, ChromaticAberrationEffect, ToneMappingEffect, ToneMappingMode, BlendFunction } from 'postprocessing';
  import { GLTFLoader } from 'three/examples/jsm/loaders/GLTFLoader.js';
  import { DRACOLoader } from 'three/examples/jsm/loaders/DRACOLoader.js';
  import { RoomEnvironment } from 'three/examples/jsm/environments/RoomEnvironment.js';

  const stage = document.getElementById('stage');
  const hintEl = document.getElementById('hint');
  const flashEl = document.getElementById('flash');
  const _coarse=matchMedia('(pointer:coarse)').matches || ('ontouchstart' in window); let fnx=0,fny=0,gnx=0,gny=0;

  // REEL escape hatch — works with or without WebGL
  const REEL_EMBED='https://www.youtube.com/embed/nC3fdpPx-II?rel=0&autoplay=1&playlist=8hCo3Clc3p0,GmR0udi-U4w,09Vc3EMFn-M,2tvW25Qu5WE,9uZmdPdPDCk,jmqzbG-bdMU';  // selects across roles until JJ cuts a true reel
  const reelBtn=document.getElementById('reelbtn'), reelBox=document.getElementById('reelbox'),
        reelFrame=document.getElementById('reelframe'), reelX=document.getElementById('reelx');
  function openReel(){ reelFrame.innerHTML='<iframe src="'+REEL_EMBED+'" allow="autoplay; fullscreen; encrypted-media" allowfullscreen></iframe>'; reelBox.classList.add('on'); reelBox.setAttribute('aria-hidden','false'); }
  function closeReel(){ reelBox.classList.remove('on'); reelBox.setAttribute('aria-hidden','true'); reelFrame.innerHTML=''; }
  reelBtn.addEventListener('click',openReel); reelX.addEventListener('click',closeReel);
  reelBox.addEventListener('click',e=>{ if(e.target===reelBox) closeReel(); });
  window.addEventListener('keydown',e=>{ if(e.key==='Escape') closeReel(); });

  // custom viewfinder cursor
  const curEl=document.getElementById('cur');
  if(curEl&&matchMedia('(pointer:fine)').matches){
    window.addEventListener('pointermove',e=>{
      curEl.style.left=e.clientX+'px'; curEl.style.top=e.clientY+'px'; curEl.classList.add('on');
      curEl.classList.toggle('big', !!(e.target&&e.target.closest&&e.target.closest('a,button')));
    });
    document.addEventListener('mouseleave',()=>curEl.classList.remove('on'));
  }

  // WebGL guard: without it, the page degrades to gradient + working shot-list links
  const _GL=(()=>{ try{ const c=document.createElement('canvas'); return !!(c.getContext('webgl2')||c.getContext('webgl')); }catch(e){ return false; } })();
  if(!_GL){ document.documentElement.classList.add('no3d'); hintEl.textContent='tap a shot on the list to step inside'; }
  if(_GL){




  const PIK=['director','producer','vfx','fun'];
  const SLATE={director:'SC 01 · “DIRECTOR” · TK 1',producer:'SC 02 · “PRODUCER” · TK 1',vfx:'SC 03 · “VFX + EDIT” · TK 1',fun:'SC 04 · “FOR FUN” · TK 1'};
  const barsEl=document.getElementById('bars'), slateEl=document.getElementById('slate');
  const reduceMotion=matchMedia('(prefers-reduced-motion: reduce)').matches;
  PIK.forEach(k=>{ const row=document.getElementById('row-'+k), ar=document.getElementById('ar-'+k); if(!row) return;
    row.addEventListener('mouseenter',()=>{ if(ar) ar.classList.add('show'); });
    row.addEventListener('mouseleave',()=>{ if(ar&&!_coarse) ar.classList.remove('show'); });
    row.addEventListener('click',e=>{ e.preventDefault(); if(cut.active) return; ensureAudio(); startCut(k, row.dataset.url); });
  });
  window.addEventListener('keydown',e=>{                     // 1–4 = shots, R = reel
    if(e.target&&/INPUT|TEXTAREA/.test(e.target.tagName)) return;
    const i=parseInt(e.key)-1;
    if(i>=0&&i<4&&!cut.active){ ensureAudio(); const row=document.getElementById('row-'+PIK[i]); if(row) startCut(PIK[i],row.dataset.url); }
    if(e.key==='r'||e.key==='R') openReel();
  });
  { const fc=document.getElementById('fmtcard'); if(fc) fc.addEventListener('click',()=>{ const orig=fc.innerHTML; fc.innerHTML='FORMATTING...'; setTimeout(()=>{ try{ document.cookie='jjvisits=;path=/;max-age=0'; }catch(e){} for(const s of shots){ s.captured=false; s.prog=0; } fc.innerHTML=orig; refreshPostIt(); }, 700); }); }
  refreshPostIt();
  const clamp=(v,a,b)=>Math.max(a,Math.min(b,v));
  const lerp=(a,b,x)=>a+(b-a)*x;
  let actx=null;
  function ensureAudio(){ if(!actx){ try{ actx=new (window.AudioContext||window.webkitAudioContext)(); }catch(e){} } if(actx&&actx.state==='suspended') actx.resume(); }
  function boop(freq,dur,vol){ if(!actx) return; const o=actx.createOscillator(),g=actx.createGain(); o.type='sine'; o.frequency.value=freq; o.connect(g); g.connect(actx.destination); const n=actx.currentTime; g.gain.setValueAtTime(0.0001,n); g.gain.exponentialRampToValueAtTime(vol,n+0.012); g.gain.exponentialRampToValueAtTime(0.0001,n+dur); o.start(n); o.stop(n+dur+0.03); }

  let W=stage.clientWidth, H=stage.clientHeight;
  const scene=new THREE.Scene();
  const sky=document.createElement('canvas'); sky.width=4; sky.height=256; const sctx=sky.getContext('2d');
  const skyTex=new THREE.CanvasTexture(sky); scene.background=skyTex;
  function drawSky(a,b,c){ const g=sctx.createLinearGradient(0,0,0,256); g.addColorStop(0,a); g.addColorStop(0.5,b); g.addColorStop(1,c); sctx.fillStyle=g; sctx.fillRect(0,0,4,256); skyTex.needsUpdate=true; }
  scene.fog=new THREE.Fog(0xb4cce6,40,230);

  const cam=new THREE.PerspectiveCamera(74,W/H,0.05,400);
  const baseX=0, baseY=6.6, baseZ=9.6; cam.position.set(baseX,baseY,baseZ); cam.lookAt(0,-0.4,-5);
  scene.add(cam); // so the camera-mounted rig renders

  const rdr=new THREE.WebGLRenderer({antialias:true,powerPreference:'high-performance'});
  rdr.setSize(W,H); rdr.setPixelRatio(Math.min(window.devicePixelRatio, matchMedia('(pointer:coarse)').matches?1.35:1.75)); rdr.toneMapping=THREE.NoToneMapping;
  stage.appendChild(rdr.domElement);

  const composer=new EffectComposer(rdr);
  composer.addPass(new RenderPass(scene,cam));
  const bloom=new BloomEffect({intensity:0.6,luminanceThreshold:0.8,luminanceSmoothing:0.3,mipmapBlur:true,radius:0.7});
  const ca=new ChromaticAberrationEffect({offset:new THREE.Vector2(0.0007,0.0007),radialModulation:false});
  const vig=new VignetteEffect({darkness:0.62,offset:0.28});
  const tone=new ToneMappingEffect({mode:ToneMappingMode.ACES_FILMIC});
  const _smallScreen = matchMedia('(pointer:coarse)').matches || window.innerWidth < 700;
  const GRAIN_BASE = _smallScreen ? 0.13 : 0.18;   // AD note: grain was flaring on pale sky
  const grain=new NoiseEffect({blendFunction:BlendFunction.OVERLAY}); grain.blendMode.opacity.value=GRAIN_BASE;
  composer.addPass(new EffectPass(cam,bloom,ca,vig,tone,grain));

  const ambL=new THREE.AmbientLight(0xc4d6f0,0.85); scene.add(ambL);
  const sun=new THREE.DirectionalLight(0xfff2da,1.25); sun.position.set(6,9,4); scene.add(sun);
  scene.add(new THREE.HemisphereLight(0xd6e4f1,0x4a5840,0.5));

  // stars
  const stg=new THREE.BufferGeometry(); const sn=320, spz=new Float32Array(sn*3);
  for(let s=0;s<sn;s++){ spz[s*3]=(Math.random()-.5)*160; spz[s*3+1]=12+Math.random()*70; spz[s*3+2]=(Math.random()-.5)*160-20; }
  stg.setAttribute('position',new THREE.BufferAttribute(spz,3));
  const stars=new THREE.Points(stg,new THREE.PointsMaterial({color:0xffffff,size:0.16,transparent:true,opacity:0})); scene.add(stars);

  // sun + moon — deep-background celestial clock (real local time; spun fast by the Producer timelapse)
  let displayHr=12;
  function discSprite(inner,outer,glow){
    const c=document.createElement('canvas'); c.width=c.height=256; const g=c.getContext('2d');
    const rg=g.createRadialGradient(128,128,10,128,128,128);
    rg.addColorStop(0,inner); rg.addColorStop(0.42,inner); rg.addColorStop(0.5,outer); rg.addColorStop(1,'rgba(0,0,0,0)');
    g.fillStyle=rg; g.fillRect(0,0,256,256);
    const tx=new THREE.CanvasTexture(c); tx.colorSpace=THREE.SRGBColorSpace;
    const sp=new THREE.Sprite(new THREE.SpriteMaterial({map:tx,transparent:true,fog:false,depthWrite:false,opacity:glow}));
    scene.add(sp); return sp;
  }
  const sunDisc=discSprite('rgba(255,242,208,1)','rgba(255,207,138,0.85)',1);  sunDisc.scale.setScalar(17);
  const moonDisc=discSprite('rgba(238,242,252,1)','rgba(170,180,216,0.7)',0.95); moonDisc.scale.setScalar(11);
  function placeSky(){
    const a=(displayHr/24)*Math.PI*2 - Math.PI*0.5;   // noon = top of arc
    const el=Math.sin(a);
    sunDisc.position.set(Math.cos(a)*95, el*24+9, -130);             // shallow arc: stays inside the letterbox
    moonDisc.position.set(Math.cos(a+Math.PI)*95, -el*24+9, -130);
    sunDisc.material.opacity=Math.max(0,Math.min(1,(el+0.12)*4));    // CT note: only one body owns the sky
    moonDisc.material.opacity=Math.max(0,Math.min(0.95,(-el+0.12)*4));
  }

  // clouds
  const loader=new THREE.TextureLoader();
  const mk=f=>{ const tx=loader.load(f); if('colorSpace' in tx) tx.colorSpace=THREE.SRGBColorSpace; return tx; };
  const puffyTexs=['/clouds/c01.webp','/clouds/c02.webp','/clouds/c03.webp','/clouds/c04.webp','/clouds/c05.webp','/clouds/c06.webp','/clouds/c07.webp','/clouds/c08.webp','/clouds/c09.webp','/clouds/c10.webp','/clouds/c11.webp','/clouds/c12.webp'].map(mk);
  const clouds=[];
  function spawnCloud(c,initial){
    const r=Math.random();
    const lane=r<0.44?0:(r<0.87?1:2);
    let x,depth,speed,s;
    if(lane===0){ x=(Math.random()<0.5?-1:1)*(34+Math.random()*44); depth=-26-Math.random()*26; speed=0.03+Math.random()*0.07; s=16+Math.random()*16; }
    else if(lane===1){ x=(Math.random()<0.5?-1:1)*(13+Math.random()*22); depth=-12-Math.random()*28; speed=0.1+Math.random()*0.32; s=10+Math.random()*12; }
    else { x=(Math.random()-0.5)*11; depth=-8-Math.random()*20; speed=0.16+Math.random()*0.4; s=9+Math.random()*10; }
    c.material.map=puffyTexs[Math.floor(Math.random()*puffyTexs.length)]; c.material.needsUpdate=true;
    const yy=Math.max(-5+Math.random()*18,-11+s*0.5); c.position.set(x,yy,initial?(-12-Math.random()*170):(-160-Math.random()*60));
    c.scale.set(s*1.5,s,1);
    c.userData.speed=speed; c.userData.maxop=0.95; c.userData.age=0; c.material.opacity=0;
  }
  const CLOUD_N=_coarse?14:22;
  for(let i=0;i<CLOUD_N;i++){ const sp=new THREE.Sprite(new THREE.SpriteMaterial({transparent:true,depthWrite:false,opacity:0})); spawnCloud(sp,true); scene.add(sp); clouds.push(sp); }

  // ground
  const gc=document.createElement('canvas'); gc.width=gc.height=512; const gg=gc.getContext('2d');
  gg.fillStyle='#9aa0a0'; gg.fillRect(0,0,512,512);   // neutral base — phase palette supplies the hue
  const tones=['#8b9190','#a5aaa6','#949a95','#b0b3aa','#878e8c','#a39f92'];
  for(let n=0;n<48;n++){ const x=Math.random()*512,y=Math.random()*512,r=40+Math.random()*130; const rg=gg.createRadialGradient(x,y,0,x,y,r); rg.addColorStop(0,tones[n%tones.length]); rg.addColorStop(1,'rgba(0,0,0,0)'); gg.globalAlpha=0.5; gg.fillStyle=rg; gg.beginPath(); gg.arc(x,y,r,0,7); gg.fill(); }
  gg.globalAlpha=1; gg.lineWidth=1; gg.strokeStyle='rgba(226,217,196,0.05)';
  for(let c=0;c<28;c++){ gg.beginPath(); const yy=c*512/28; for(let x=0;x<=512;x+=8){ const off=Math.sin(x*0.018+c)*12+Math.sin(x*0.045+c*1.7)*6; (x===0)?gg.moveTo(x,yy+off):gg.lineTo(x,yy+off); } gg.stroke(); }
  for(let d=0;d<500;d++){ gg.fillStyle='rgba(0,0,0,'+(Math.random()*0.07)+')'; gg.fillRect(Math.random()*512,Math.random()*512,2,2); }
  const gt=new THREE.CanvasTexture(gc); gt.wrapS=gt.wrapT=THREE.RepeatWrapping; gt.repeat.set(12,12);
  const gGeo=new THREE.PlaneGeometry(760,760,90,90), gp=gGeo.attributes.position, curv=0.00068;
  for(let vi=0;vi<gp.count;vi++){ const gx=gp.getX(vi),gy=gp.getY(vi); gp.setZ(vi,-curv*(gx*gx+gy*gy)); }
  gGeo.computeVertexNormals();
  const ground=new THREE.Mesh(gGeo,new THREE.MeshStandardMaterial({map:gt,roughness:1})); ground.rotation.x=-Math.PI/2; ground.position.y=-12; scene.add(ground);

  // env + house
  const house=new THREE.Group(); scene.add(house);
  const glassMats=[]; const houseMats=[]; let currentNight=0;
