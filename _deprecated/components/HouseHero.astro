    holdTimer=setTimeout(()=>{ if(!spinning) startRec(); },500);
  }
  function mv(e){ setCursor(e); if(recording) return; if(!dragging) return; const p=pos(e); const dx=p.x-px, dy=p.y-py; px=p.x; py=p.y; moved=Math.hypot(p.x-sx,p.y-sy);
    if(moved>6){ spinning=true; if(holdTimer){clearTimeout(holdTimer); holdTimer=null;}
      house.rotateOnWorldAxis(AY,dx*0.0008); house.rotateOnWorldAxis(AX,dy*0.0008);
      velY=clamp(dx*0.0008,-0.04,0.04); velX=clamp(dy*0.0008,-0.04,0.04);
    }
  }
  function up(e){ if(holdTimer){clearTimeout(holdTimer); holdTimer=null;} if(recording) stopRec(); dragging=false; stage.style.cursor='grab'; }
  stage.addEventListener('mousedown',dn); window.addEventListener('mousemove',mv); window.addEventListener('mouseup',up);
  stage.addEventListener('touchstart',dn,{passive:true}); window.addEventListener('touchmove',mv,{passive:true}); window.addEventListener('touchend',up);
  window.addEventListener('resize',()=>{ W=stage.clientWidth; H=stage.clientHeight; cam.aspect=W/H; cam.updateProjectionMatrix(); rdr.setSize(W,H); composer.setSize(W,H); applyResponsive(); });
  window.addEventListener('pageshow',()=>{ if(flashEl) flashEl.classList.remove('on'); cut.active=false; cut.fired=false; barsEl.classList.remove('on'); slateEl.classList.remove('on'); ca.offset.set(0.0007,0.0007); grain.blendMode.opacity.value=GRAIN_BASE; cloudMul=1; house.position.x=0; try{ stageMode(false); setWireframe(false); meadowMode(false); applyTOD(realHr()); }catch(e){} if(rigPivot.children.length) rigPivot.visible=true; hintEl.style.opacity=''; recording=false; capturing=false; pushIn=0; activeShot=null; try{ const v=getVisits(); for(const s of shots){ s.prog=0; s.captured=(v[s.key]||0)>=1; } }catch(e){} refreshPostIt(); });

  // HUD draw
  let tcFrames=0;
  function two(n){ return (n<10?'0':'')+n; }
  function drawHUD(){
    hx.clearRect(0,0,RIG_W,RIG_H);
    const m=26;
    // corner brackets
    hx.strokeStyle='rgba(235,240,245,0.85)'; hx.lineWidth=2; const bl=26;
    const cs=[[m,m,1,1],[RIG_W-m,m,-1,1],[m,RIG_H-m,1,-1],[RIG_W-m,RIG_H-m,-1,-1]];
    cs.forEach(([x,y,sxg,syg])=>{ hx.beginPath(); hx.moveTo(x,y+syg*bl); hx.lineTo(x,y); hx.lineTo(x+sxg*bl,y); hx.stroke(); });
    // center reticle
    hx.strokeStyle='rgba(235,240,245,0.5)'; hx.lineWidth=1.5;
    const cx=RIG_W/2, cy=RIG_H/2;
    hx.beginPath(); hx.moveTo(cx-12,cy); hx.lineTo(cx-4,cy); hx.moveTo(cx+4,cy); hx.lineTo(cx+12,cy);
    hx.moveTo(cx,cy-12); hx.lineTo(cx,cy-4); hx.moveTo(cx,cy+4); hx.lineTo(cx,cy+12); hx.stroke();
    // thirds (faint)
    hx.strokeStyle='rgba(235,240,245,0.12)'; hx.lineWidth=1;
    for(let i=1;i<3;i++){ hx.beginPath(); hx.moveTo(RIG_W*i/3,m); hx.lineTo(RIG_W*i/3,RIG_H-m); hx.stroke(); hx.beginPath(); hx.moveTo(m,RIG_H*i/3); hx.lineTo(RIG_W-m,RIG_H*i/3); hx.stroke(); }
    // top-left REC / STBY + timecode
    hx.font='600 17px "IBM Plex Mono", ui-monospace, monospace'; hx.textBaseline='middle';
    if(recording){ tcFrames++; const blink=(Math.floor(t*2)%2===0);
      if(blink){ hx.fillStyle='#ff3b30'; hx.beginPath(); hx.arc(m+8,m+14,7,0,7); hx.fill(); }
      hx.fillStyle='#ff3b30'; hx.fillText('REC', m+24, m+14);
    } else { hx.strokeStyle='rgba(235,240,245,0.7)'; hx.lineWidth=2; hx.beginPath(); hx.arc(m+8,m+14,7,0,7); hx.stroke();
      hx.fillStyle='rgba(235,240,245,0.7)'; hx.fillText('STBY', m+24, m+14);
    }
    const ff2=tcFrames%24, ss=Math.floor(tcFrames/24)%60, mm=Math.floor(tcFrames/1440)%60, hh=Math.floor(tcFrames/86400)%24;
    hx.fillStyle='rgba(235,240,245,0.9)'; hx.font='600 16px "IBM Plex Mono", ui-monospace, monospace';
    hx.fillText(two(hh)+':'+two(mm)+':'+two(ss)+':'+two(ff2), RIG_W-128, m+14);
    // bottom readout
    hx.fillStyle='rgba(235,240,245,0.7)'; hx.font='600 14px "IBM Plex Mono", ui-monospace, monospace';
    hx.fillText('4K  24fps  f2.8  ISO 800', m+2, RIG_H-m-6);
    hx.fillText('A-CAM', RIG_W-92, RIG_H-m-6);
    for(const m of shotHUD){
      const sx=(m.x*0.5+0.5)*RIG_W, sy=(0.5-m.y*0.5)*RIG_H; const R=20;
      hx.save(); hx.globalAlpha=m.on?1:0.25; hx.textAlign='center';
      hx.strokeStyle=m.lined?'rgba(255,210,120,0.95)':'rgba(235,240,245,0.6)'; hx.lineWidth=2.5; hx.beginPath(); hx.arc(sx,sy,R,0,7); hx.stroke();
      if(m.prog>0){ hx.strokeStyle='#ff3b30'; hx.lineWidth=4; hx.beginPath(); hx.arc(sx,sy,R,-Math.PI/2,-Math.PI/2+m.prog*Math.PI*2); hx.stroke(); }
      hx.fillStyle=m.lined?'rgba(255,210,120,0.95)':'rgba(235,240,245,0.7)'; hx.beginPath(); hx.arc(sx,sy,2.5,0,7); hx.fill();
      // label with dark plate for legibility (esp. small screens)
      hx.font='700 16px "IBM Plex Mono", ui-monospace, monospace';
      const lbl=m.label.toUpperCase(), tw=hx.measureText(lbl).width, ly=sy+R+18;
      hx.fillStyle='rgba(8,10,14,0.72)'; const px2=8,py2=5;
      if(hx.roundRect){ hx.beginPath(); hx.roundRect(sx-tw/2-px2, ly-11-py2/2, tw+px2*2, 22+py2, 4); hx.fill(); } else { hx.fillRect(sx-tw/2-px2, ly-11-py2/2, tw+px2*2, 22+py2); }
      hx.fillStyle=m.lined?'rgba(255,215,130,1)':'rgba(240,244,248,0.95)'; hx.fillText(lbl, sx, ly);
      hx.restore();
    }
    hx.textAlign='left';
    hudTex.needsUpdate=true;
  }

  // lens cam state (lagged)
  const lensPos=new THREE.Vector3(baseX,baseY,baseZ);
  const lensTarget=new THREE.Vector3(0,2.5,0);
  const tmpV=new THREE.Vector3(); const lensQuat=new THREE.Quaternion(); const tmpQ=new THREE.Quaternion(); lensQuat.copy(cam.quaternion);

  // ===== ONBOARDING: first-visit demo + staged hints =====
  let interacted=false;
  stage.addEventListener('pointerdown',()=>{ interacted=true; },{once:true,capture:true});
  const HOLD_WORD=_coarse?'hold':'click + hold';
  function setHint(s){ hintEl.innerHTML=s; hintEl.style.opacity='0'; setTimeout(()=>{ if(!recording&&!cut.active) hintEl.style.opacity='0.85'; },350); setTimeout(()=>hintEl.style.transition='opacity .5s',0); }
  const firstVisit=!/jjseen=1/.test(document.cookie);
  if(firstVisit && !reduceMotion){
    try{ document.cookie='jjseen=1;path=/;max-age=31536000'; }catch(e){}
    setHint('you’re holding the camera — move to look around');
    setTimeout(()=>{ if(interacted) return;                      // tiny auto-demo: camera pans + REC blips once
      recording=true; recCX=0; recCY=0; let dt0=0;
      const demo=setInterval(()=>{ dt0+=0.05; gnx=Math.sin(dt0*2.2)*0.35; gny=Math.sin(dt0*1.4)*0.15;
        if(dt0>1.7){ clearInterval(demo); gnx=0; gny=0; recording=false;
          setHint('press and hold to record a shot · line one up to step inside'); } },50);
    },3200);
    setTimeout(()=>{ if(!cut.active) setHint('in a hurry? the SHOT LIST ↙ is always open'); },11000);
  } else {
    setHint('move to frame · press and hold to record a shot · or tap the shot list ↙');
  }

  // ambient "record layer" leak: every so often the windows flicker from memory (aurora) to record (footage)
  let nextFlick=16+Math.random()*10, flickOn=false, flickEnd=0;

  let shake=0, nextShake=3+Math.random()*4;
  function loop(){
    t+=0.016; const dt=Math.min(capClock.getDelta(),0.05);
    // eased cursor
    mnx=Math.max(-1,Math.min(1,fnx+gnx)); mny=Math.max(-1,Math.min(1,fny+gny)); emnx=lerp(emnx,mnx,0.08); emny=lerp(emny,mny,0.08);
    pushIn=lerp(pushIn, recording?1:0, 0.05);
    if(recLightMat){ const rl=(recording||cut.active)?(2.6+Math.sin(t*5)*0.5):0.0; recLightMat.emissiveIntensity=lerp(recLightMat.emissiveIntensity, rl, 0.3); }

    // house idle spin + drag inertia (weightier: momentum carries far longer)
    if((!dragging || recording) && !(cut.active&&cut.key==='producer')){ house.rotateOnWorldAxis(AY,velY); house.rotateOnWorldAxis(AX,velX); velY*=0.95; velX*=0.95;
      house.rotateOnWorldAxis(AY,0.0010); }
    house.position.y=(cut.active&&cut.key==='producer')?2.3:2.5+Math.sin(t*0.7)*0.13;
    placeSky(); if((t*30|0)%2===0) drawAurora(t);
    if(!reduceMotion && t>nextFlick && !flickOn && !cut.active && glassMats.length){
      makeWallVideo(); wallVideo.play().then(()=>{
        for(const m of glassMats){ m.emissiveMap=wallVidTex; m.needsUpdate=true; }
        flickOn=true; flickEnd=t+0.9;
      }).catch(()=>{});
      nextFlick=t+20+Math.random()*22;
    }
    if(flickOn && t>flickEnd){
      for(const m of glassMats){ m.emissiveMap=auroraTex; m.needsUpdate=true; }
      flickOn=false; if(wallVideo&&!stageOn) wallVideo.pause();
    }
    sunDisc.visible=!stageOn; moonDisc.visible=!stageOn;
    if(tickerGrp){ tickerGrp.visible=!stageOn&&!(cut.active&&cut.key!=='fun');
      tickerGrp.position.set(-8.4, house.position.y-4.6+Math.sin(t*0.5+1)*0.18, -4.5);
      tickerTex.offset.x=(t*0.028)%1; }
    gt.offset.y+=0.0016;

    if(!cut.active){
      // camera: idle shake + AIM toward cursor (point the rig where you look) + push-in on record
      if(t>nextShake){ shake=0.0; nextShake=t+4+Math.random()*6; } shake*=0.86;
      aimYaw=lerp(aimYaw, recording?clamp(-(emnx-recCX)*0.7,-0.5,0.5):-emnx*0.13, 0.08); aimPitch=lerp(aimPitch, recording?clamp((emny-recCY)*0.5,-0.38,0.38):emny*0.09, 0.08);
      const _csh=shake; cam.position.set(baseX+(Math.random()-.5)*_csh, baseY+(Math.random()-.5)*_csh, baseZ);
      cam.lookAt((Math.random()-.5)*shake*0.4, -0.4+(Math.random()-.5)*shake*0.4, -5);
      cam.rotateY(aimYaw); cam.rotateX(aimPitch);
      cam.fov=lerp(cam.fov, 74 - pushIn*20, 0.08);
    } else {
      // ===== CUT SCENES: full cutaways — we're watching the movie now =====
      cut.t+=dt; const p=Math.min(1,cut.t/cut.dur), e=easeIO(p);
      if(cut.key==='director'){
        // "the wide" — truly locked off, super wide; the house flies through frame right to left
        cam.fov=44;
        cam.position.set(0, 3.0, 34); cam.lookAt(0, 4.5, 0);
        house.position.x=16-32*p;
      } else if(cut.key==='producer'){
        // "the timelapse" — house at rest in a flowery field, camera unmoving, the day rips by
        meadowMode(true);
        cam.fov=46; cam.position.set(0, 3.4, 27); cam.lookAt(0, 2.2, 0);
        applyTOD(realHr()+p*24);
        cloudMul=9;                                    // peaceful: the day drifts, doesn't rip
      } else if(cut.key==='vfx'){
        // "the plate" — two shots. SHOT 1: locked wide in the sky… one clean glitch… hold on the volume.
        // SHOT 2: cut to BTS coverage angle of the stage.
        if(p<0.70){ cam.fov=42; cam.position.set(0, 2.8, 21); cam.lookAt(0, 2.8, 0); }
        else { cam.fov=38; cam.position.set(0, 5.5, 47); cam.lookAt(0, 3.2, 0); }   // SHOT 2: extreme wide — whole volume in the black soundstage
        if(p<0.40){ if(stageOn) stageMode(false); }
        else if(p<0.45){                               // THE glitch — brief, singular
          if(!cut._w1){ cut._w1=1; boop(160,0.09,0.07); }
          const fl=Math.floor(p*160)%2===0; if(fl!==stageOn) stageMode(fl);
          ca.offset.set(0.010,0.008); grain.blendMode.opacity.value=0.7;
          setWireframe(Math.floor(p*240)%3===0);
        } else {                                        // …and hold. Let the reveal breathe.
          if(!stageOn) stageMode(true);
          setWireframe(false);
          ca.offset.set(0.0007,0.0007);
          grain.blendMode.opacity.value=lerp(grain.blendMode.opacity.value,GRAIN_BASE,0.15);
          if(!cut._w2&&p>=0.70){ cut._w2=1; boop(700,0.06,0.04); }   // soft cut to shot 2
          if(!cut._w3&&p>=0.56){ cut._w3=1; makeWallVideo();          // the wall starts PLAYING JJ's work
            wallVideo.play().catch(()=>{});
            if(stageWall&&wallVidTex){ stageWall.material.map=wallVidTex; stageWall.material.needsUpdate=true; } }
        }
      } else if(cut.key==='fun'){
        // "the toy plane" — hands keep the camera; a kid swooping it around the house
        const ang=e*Math.PI*1.5-0.4, r=11.5-4.5*Math.sin(e*Math.PI);
        cam.position.set(Math.sin(ang)*r, 4.2+Math.sin(e*6.0)*1.5, Math.cos(ang)*r);
        cam.lookAt(0, 2.5+Math.sin(e*9)*0.3, 0);
        cam.rotateZ(Math.sin(e*4.5)*0.16);
        cam.fov=66+Math.sin(e*Math.PI)*14;
        if(!cut._w1&&p>0.3){ cut._w1=1; boop(320,0.25,0.03); }
        if(!cut._w2&&p>0.7){ cut._w2=1; boop(260,0.25,0.03); }
      }
      if(p>=1&&!cut.fired){ cut.fired=true; slateEl.classList.remove('on'); boop(2000,0.05,0.07);
        if(flashEl) flashEl.classList.add('on'); setTimeout(()=>{ window.location.href=cut.url; },380); }
    }
    cam.updateProjectionMatrix();

    // rig viewmodel: subtle handheld sway (rig points where the camera aims)
    if(rigPivot.visible){
      rigPivot.position.lerp(tmpV.set(rigBasePos.x+emnx*0.04, rigBasePos.y-emny*0.025 + pushIn*0.13, rigBasePos.z + pushIn*0.05),0.16);
      rigPivot.rotation.y=lerp(rigPivot.rotation.y, Math.PI + emnx*0.05, 0.12);
      rigPivot.rotation.x=lerp(rigPivot.rotation.x, emny*0.04, 0.12);
    }

    // lens camera: framed on the house, pans with the cursor, lagged a beat ("through the monitor" delay)
    cam.updateMatrixWorld();
    cam.getWorldPosition(tmpV); lensPos.lerp(tmpV,0.10); focusZoom=lerp(focusZoom, activeShot?(0.3+0.7*activeShot.prog):0, 0.08);
    const _lx=recording?clamp((emnx-recCX)*3.2,-3,3):0, _ly=recording?clamp((emny-recCY)*2.4,-2.2,2.2):0; lensTarget.lerp(tmpV.set(_lx, 2.5 - _ly, 0), 0.06);
    lensCam.position.copy(lensPos); lensCam.fov=72-focusZoom*32; lensCam.updateProjectionMatrix(); lensCam.lookAt(lensTarget);

    // --- SHOTS: lined-up detection + capture meter (recording only) ---
    shotHUD.length=0;
    if(recording && shots.length){
      lensCam.updateMatrixWorld(); house.getWorldPosition(_hc);
      let best=null, bestD=1e9;
      for(const sh of shots){ if(sh.captured) continue;
        sh.node.getWorldPosition(_aw); _av.copy(_aw).project(lensCam);
        const facing=_aw.clone().sub(_hc).normalize().dot(lensPos.clone().sub(_hc).normalize());
        const on=facing>0.08 && _av.z<1 && Math.abs(_av.x)<1.3 && Math.abs(_av.y)<1.3;
        sh._ndc={x:_av.x,y:_av.y,on:on}; sh._lined=false;
        const d=Math.hypot(_av.x,_av.y); if(on && d<bestD){ bestD=d; best=sh; } }
      const LOCK_IN=0.16, LOCK_OUT=0.28; if(best){ let f=(LOCK_OUT-bestD)/(LOCK_OUT-LOCK_IN); f=Math.max(-1,Math.min(1,f)); best.prog=Math.max(0,Math.min(1, best.prog+f*dt/3.0)); best._lined=f>0; activeShot=(best.prog>0.001||f>0)?best:null; } else activeShot=null;
      for(const sh of shots){ if(sh!==best && !sh.captured) sh.prog=Math.max(0,sh.prog-dt/1.6); }
      capShudder=activeShot?activeShot.prog:0;
      for(const sh of shots){ if(!sh.captured && sh._ndc) shotHUD.push({x:sh._ndc.x,y:sh._ndc.y,on:sh._ndc.on,label:sh.label,prog:sh.prog,lined:sh._lined}); }
      if(activeShot && activeShot.prog>=1 && !capturing){ capturing=true; doCapture(activeShot); }
    } else { capShudder=0; if(!recording){ for(const sh of shots) sh.prog=Math.max(0,sh.prog-0.05); } }

    // ---- PASS 1: house feed -> render target (rig hidden), then HUD overlay ----
    drawHUD();
    const wasVisible=rigPivot.visible; rigPivot.visible=false;
    rdr.setRenderTarget(rt); rdr.clear(); rdr.render(scene,lensCam);
    rdr.autoClear=false; rdr.render(hudScene,hudCam); rdr.autoClear=true;
    rdr.setRenderTarget(null);
    rigPivot.visible=wasVisible;

    // clouds
    if(!cut.active) cloudMul=1;
    for(let ci=0;ci<clouds.length;ci++){ const c=clouds[ci]; c.position.z+=c.userData.speed*cloudMul; c.userData.age+=0.016;
      const dz=c.position.z-baseZ; let op=c.userData.maxop; if(dz>-3) op=Math.max(0,c.userData.maxop*(1-(dz+3)/6));
      op*=clamp(c.userData.age/0.8,0,1); c.material.opacity=op; if(c.position.z>baseZ+6) spawnCloud(c,false); }

    // ---- PASS 2: full view with rig viewmodel ----
    composer.render();
    requestAnimationFrame(loop);
  }
  loop();
  } // end WebGL guard
  </script>
