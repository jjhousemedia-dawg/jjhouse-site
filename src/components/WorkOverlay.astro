---
/**
 * Work overlay — 2026-08-19. The sixnfive.com step-in / scroll-out.
 *
 * Reference mechanic (read out of their theme JS, main.js + project.js):
 * clicking a project keeps the page you were on exactly where it is, lays a
 * full-viewport frame over it with its own scroll, loads the project into
 * that frame, and pushes the project URL. There is no close button. The way
 * out is THE SCROLL: when the frame's own scroll reaches its bottom, the
 * frame fades and you are back on the page you left, at the spot you left it.
 * (Their version snaps to a 600ms fade at the very bottom; ours maps the
 * fade onto the last stretch of scroll — the tail — so the page underneath
 * reappears WITH the gesture, which is the feel JJ actually described.)
 *
 * Ruled by JJ 2026-08-19:
 * - Player: the host's player (youtube-nocookie / player.vimeo), embedded
 *   immediately when the overlay opens. You clicked to see the work; it is
 *   ready. No autoplay. White progress bar, minimal chrome — the b/w system.
 * - Story-less projects (43 of 46): clean — title, roles, player, credits.
 *   The four-line bracket scaffold stays a standalone-page thing; a cold
 *   viewer in the overlay never meets empty brackets.
 * - URL: pushState to /work/slug while open. Shareable and honest — the
 *   copied link is the project's real page. Back closes the overlay.
 * - Exit: scroll is the only VISIBLE exit. ESC and the back button quietly
 *   work. A faint ( keep scrolling ) cue sits in the tail.
 *
 * How content gets here: no AJAX endpoint exists and none is allowed (pure
 * static, JJ ruled 8/18 against an adapter). But every project already HAS a
 * static page — /work/[slug]/ — so the overlay fetches that built HTML,
 * parses it, and lifts the pieces it wants. One source of truth, and with
 * JS off the links are ordinary navigations to those same pages.
 *
 * Scroll feel: the page Lenis is stopped while the overlay is up (same shape
 * as the menu) and a second Lenis instance rides the overlay's own wrapper,
 * so the frame scrolls like the rest of the site. Destroyed on close.
 */
---
<section class="wo" id="wo" hidden role="dialog" aria-modal="true" aria-label="Project" tabindex="-1">
  <div class="wo__scroll" id="woScroll">
    <div class="wo__inner" id="woInner">
      <p class="wo__loading label">( loading )</p>
      <article class="wo__body" id="woBody"></article>
      <div class="wo__tail" aria-hidden="true">
        <span class="wo__cue label">( keep scrolling )</span>
      </div>
    </div>
  </div>
</section>

<script>
  import Lenis from 'lenis';

  const wo = document.getElementById('wo');
  const scroller = document.getElementById('woScroll');
  const inner = document.getElementById('woInner');
  const body = document.getElementById('woBody');
  const tail = wo && wo.querySelector('.wo__tail');

  if (wo && scroller && inner && body && tail) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    // The page this script was built into — '/' or '/work'. Read once,
    // before any pushState muddies location.pathname.
    const HOST_PATH = location.pathname;

    let isOpen = false;
    let closing = false;
    let releasing = false;
    let lenis2 = null;
    let raf2 = 0;
    let lastFocus = null;

    // ---- fetch + cache. pointerover prefetch makes most opens instant. ----
    const cache = new Map();
    const fetchProject = (slug) => {
      if (!cache.has(slug)) {
        const p = fetch(`/work/${slug}/`).then((r) => {
          if (!r.ok) throw new Error(String(r.status));
          return r.text();
        });
        // a failed fetch must not poison the cache
        p.catch(() => { cache.delete(slug); });
        cache.set(slug, p);
      }
      return cache.get(slug);
    };

    const slugFrom = (a) => {
      if (a.origin !== location.origin) return null;
      const m = a.pathname.match(/^\/work\/([^/]+)\/?$/);
      return m ? m[1] : null;
    };

    // ---- the player. NO host chrome at all (JJ, 2026-08-20). ----
    // controls=0 on both hosts, autoplay lands MUTED (which is what makes
    // the browser allow it), and every popup the params can reach is off:
    // related videos capped to the channel (rel=0 is as far as YouTube
    // goes), annotations (iv_load_policy=3), keyboard overlays
    // (disablekb=1), the fullscreen button (fs=0), Vimeo's title/byline/
    // portrait/pip. Vimeo honours controls=0 only when the video's OWNER
    // is on a paid plan — best-effort by ruling (JJ, 2026-08-20) until
    // the Mux migration makes the whole question moot.
    //
    // With the chrome gone the iframe can't be the control surface, so a
    // transparent SHIELD button sits over it — the host never sees the
    // pointer (its hover chrome never wakes) and the click drives
    // play/pause over postMessage. The Sound pill is the one visible
    // control: unmute, in the same dress as the parked .reel__sound.
    // The static /work/ pages deliberately KEEP native controls: they
    // are the no-JS fallback, and postMessage needs JS.
    const esc = (s) => String(s).replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;');
    const embed = (type, id, title) => {
      const src = type === 'youtube'
        ? `https://www.youtube-nocookie.com/embed/${encodeURIComponent(id)}?autoplay=1&mute=1&controls=0&rel=0&playsinline=1&iv_load_policy=3&disablekb=1&fs=0&color=white&enablejsapi=1&origin=${encodeURIComponent(location.origin)}`
        : `https://player.vimeo.com/video/${encodeURIComponent(id)}?autoplay=1&muted=1&controls=0&title=0&byline=0&portrait=0&pip=0&keyboard=0&transparent=0&color=ffffff&dnt=1`;
      // The sound control is an ICON, not a word (JJ, 2026-08-20 round 5):
      // speaker with an x while muted, speaker with waves once sound is on.
      // Inline SVG, currentColor, so it obeys the b/w system for free.
      return `<div class="pp__media wo__media" data-player="${type}">
        <iframe src="${src}" title="${esc(title)}" allow="autoplay; fullscreen; encrypted-media" allowfullscreen></iframe>
        <button class="wo__shield" type="button" aria-label="Play or pause"></button>
        <button class="wo__sound" type="button" aria-pressed="false" aria-label="Sound">
          <svg class="wo__ico wo__ico--off" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9.5v5h3.2L12 18.5v-13L7.2 9.5H4z"/><path class="wo__stroke" d="M15.5 9.5l5 5m0-5l-5 5"/></svg>
          <svg class="wo__ico wo__ico--on" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9.5v5h3.2L12 18.5v-13L7.2 9.5H4z"/><path class="wo__stroke" d="M15.5 8.8a4.6 4.6 0 0 1 0 6.4M17.8 6.6a7.9 7.9 0 0 1 0 10.8"/></svg>
        </button>
      </div>`;
    };

    // The two hosts speak different postMessage dialects; both are fine
    // with fire-and-forget commands. State is tracked locally — with the
    // chrome gone there is nothing on the far side to disagree with.
    const wirePlayer = (media) => {
      const type = media.dataset.player;
      const iframe = media.querySelector('iframe');
      const shield = media.querySelector('.wo__shield');
      const pill = media.querySelector('.wo__sound');
      if (!iframe || !shield || !pill) return;
      const HOST = type === 'youtube' ? 'https://www.youtube-nocookie.com' : 'https://player.vimeo.com';
      const send = (msg) => {
        try { iframe.contentWindow.postMessage(JSON.stringify(msg), HOST); } catch (e) {}
      };
      // ⛔ THE HANDSHAKE (found via JJ's "not working on desktop",
      // 2026-08-20): a YouTube widget silently DISCARDS every command
      // until the parent has introduced itself with a `listening` event —
      // that is what the official iframe_api script does under the hood;
      // enablejsapi=1 alone is not enough, and nothing errors. Sent when
      // the iframe loads AND again before each command: it is idempotent,
      // and re-greeting survives a slow player boot or a src swap.
      const hello = () => { if (type === 'youtube') send({ event: 'listening', id: 1, channel: 'widget' }); };
      iframe.addEventListener('load', hello);
      hello();
      const yt = (func, args) => { hello(); send({ event: 'command', func, args: args || [], id: 1, channel: 'widget' }); };
      const vm = (method, value) => send(value === undefined ? { method } : { method, value });
      let playing = true, muted = true;
      shield.addEventListener('click', () => {
        playing = !playing;
        if (type === 'youtube') yt(playing ? 'playVideo' : 'pauseVideo');
        else vm(playing ? 'play' : 'pause');
      });
      pill.addEventListener('click', () => {
        muted = !muted;
        if (type === 'youtube') { yt(muted ? 'mute' : 'unMute'); if (!muted) yt('setVolume', [100]); }
        else { vm('setMuted', muted); if (!muted) vm('setVolume', 1); }
        pill.setAttribute('aria-pressed', String(!muted));
      });
    };

    const render = (html, slug) => {
      const doc = new DOMParser().parseFromString(html, 'text/html');
      const pp = doc.querySelector('.pp');
      if (!pp) throw new Error('unexpected page shape');
      const pick = (sel) => {
        const el = pp.querySelector(sel);
        return el ? el.outerHTML : '';
      };
      const media = pp.querySelector('#ppMedia');
      const mediaHtml = media
        ? embed(media.dataset.type, media.dataset.vid, media.dataset.title || 'Video')
        : '';
      // Clean shape (JJ, 8/19): the bracket scaffold (.pp__anecdote) is
      // deliberately NOT picked. Story and credits ride along when they exist.
      body.innerHTML =
        pick('.pp__title') +
        pick('.pp__roles') +
        mediaHtml +
        pick('.pp__story') +
        pick('.pp__credits') +
        pick('.pp__next');
      body.dataset.slug = slug;
      const mediaEl = body.querySelector('.wo__media');
      if (mediaEl) wirePlayer(mediaEl);
    };

    // ---- overlay scroll: the fade IS the scroll ----------------------------
    // Opacity maps over the tail zone, so the page underneath resolves in
    // exactly as fast as the visitor commits — and scrolling back up
    // un-fades. Bottom = release.
    const onScroll = () => {
      if (!isOpen || closing) return;
      const max = scroller.scrollHeight - scroller.clientHeight;
      if (max <= 0) return;
      const zone = Math.min(tail.offsetHeight || 1, max);
      const t = Math.min(1, Math.max(0, (scroller.scrollTop - (max - zone)) / zone));
      wo.style.opacity = String(1 - t * t); // gentle start, committed end
      if (scroller.scrollTop >= max - 1 && !releasing) {
        releasing = true;
        exitByScroll();
      }
    };
    scroller.addEventListener('scroll', onScroll, { passive: true });

    const startLenis2 = () => {
      if (reduce) return;
      lenis2 = new Lenis({
        wrapper: scroller,
        content: inner,
        duration: 1.05,
        easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
        smoothWheel: true,
        touchMultiplier: 1.6,
      });
      const loop = (time) => {
        if (!lenis2) return;
        lenis2.raf(time);
        raf2 = requestAnimationFrame(loop);
      };
      raf2 = requestAnimationFrame(loop);
    };
    const stopLenis2 = () => {
      cancelAnimationFrame(raf2);
      if (lenis2) { lenis2.destroy(); lenis2 = null; }
    };

    // ---- lifecycle ---------------------------------------------------------
    const openOverlay = async (slug, push = true) => {
      if (isOpen) return;
      isOpen = true;
      releasing = false;
      lastFocus = document.activeElement;
      body.innerHTML = '';
      wo.classList.add('is-loading');
      wo.hidden = false;
      document.documentElement.classList.add('wo-open');
      if (window.__lenis) window.__lenis.stop();
      wo.style.transition = reduce ? 'none' : 'opacity 600ms var(--ease)';
      wo.style.opacity = '0';
      void wo.offsetWidth; // commit the start frame
      wo.style.opacity = '1';
      // hand opacity over to the scroll map once the entrance lands
      setTimeout(() => { wo.style.transition = 'none'; }, reduce ? 0 : 620);
      if (push) history.pushState({ wo: slug }, '', `/work/${slug}`);
      scroller.scrollTop = 0;
      startLenis2();
      wo.focus({ preventScroll: true });
      try {
        const html = await fetchProject(slug);
        if (!isOpen) return;
        render(html, slug);
      } catch (err) {
        // dead overlay is worse than a page load — fall through to the real page
        location.href = `/work/${slug}`;
        return;
      }
      wo.classList.remove('is-loading');
    };

    const teardown = () => {
      isOpen = false;
      releasing = false;
      stopLenis2();
      wo.hidden = true;
      wo.style.opacity = '0';
      body.innerHTML = '';
      document.documentElement.classList.remove('wo-open');
      if (window.__lenis) window.__lenis.start();
      if (lastFocus && lastFocus.focus) lastFocus.focus({ preventScroll: true });
    };

    // Scroll exit: the fade already happened WITH the scroll; the overlay is
    // at opacity 0. Consume the history entry we pushed — the popstate
    // handler below sees `closing` and finishes at once.
    const exitByScroll = () => {
      if (!isOpen || closing) return;
      closing = true;
      history.back();
    };

    // ESC / "All work" while the archive is underneath: quick fade, then
    // walk history back so the stack stays clean.
    const closeThenBack = () => {
      if (!isOpen || closing) return;
      closing = true;
      wo.style.transition = reduce ? 'none' : 'opacity 420ms var(--ease)';
      wo.style.opacity = '0';
      setTimeout(() => {
        closing = false;
        teardown();
        history.back();
      }, reduce ? 0 : 430);
    };

    window.addEventListener('popstate', (e) => {
      const st = e.state;
      if (isOpen && !(st && st.wo)) {
        if (closing) {
          // scroll exit completing — already faded
          closing = false;
          teardown();
        } else {
          // real back button
          closing = true;
          wo.style.transition = reduce ? 'none' : 'opacity 420ms var(--ease)';
          wo.style.opacity = '0';
          setTimeout(() => { closing = false; teardown(); }, reduce ? 0 : 430);
        }
      } else if (!isOpen && st && st.wo) {
        // forward button back into a project
        openOverlay(st.wo, false);
      }
    });

    window.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape' || !isOpen) return;
      const menu = document.getElementById('menu');
      if (menu && !menu.hidden) return; // menu's own ESC wins
      closeThenBack();
    });

    // ---- in-overlay navigation: Next swaps in place ------------------------
    const swap = async (slug) => {
      try {
        const p = fetchProject(slug);
        body.classList.add('is-swapping');
        const html = await p;
        if (!isOpen) return;
        render(html, slug);
        history.replaceState({ wo: slug }, '', `/work/${slug}`);
        if (lenis2) lenis2.scrollTo(0, { immediate: true });
        scroller.scrollTop = 0;
        wo.style.opacity = '1';
        requestAnimationFrame(() => body.classList.remove('is-swapping'));
      } catch (err) {
        location.href = `/work/${slug}`;
      }
    };

    document.addEventListener('click', (e) => {
      if (e.defaultPrevented) return;
      const a = e.target.closest('a');
      if (!a) return;
      if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
      if (a.target === '_blank') return;
      const slug = slugFrom(a);
      if (isOpen && wo.contains(a)) {
        if (slug) { e.preventDefault(); swap(slug); return; }
        if ((a.pathname === '/work' || a.pathname === '/work/') && (HOST_PATH === '/work' || HOST_PATH === '/work/')) {
          // "All work" with the archive already underneath — just step out
          e.preventDefault();
          closeThenBack();
        }
        return;
      }
      if (!isOpen && slug) {
        e.preventDefault();
        openOverlay(slug);
      }
    });

    // warm the cache the moment a row or card is even considered
    document.addEventListener('pointerover', (e) => {
      const a = e.target.closest('a');
      if (!a || wo.contains(a)) return;
      const slug = slugFrom(a);
      if (slug) fetchProject(slug).catch(() => {});
    }, { passive: true });

    // ---- refresh-mid-overlay recovery (JJ, 2026-08-20) -------------------
    // Refreshing /work/slug used to strand the visitor on the static page:
    // no scroll-out, no overlay, "sorta locked". The static page now
    // detects that case (history.state.wo survives a reload) and redirects
    // here with ?open=. Rebuild the intended stack from scratch: clean the
    // URL back to the host page, then open the overlay exactly as if the
    // row had been clicked — pushState, scroll-exit, ESC and back all work.
    const boot = new URLSearchParams(location.search).get('open');
    if (boot && /^[\w-]+$/.test(boot)) {
      history.replaceState(null, '', HOST_PATH);
      requestAnimationFrame(() => openOverlay(boot));
    }
  }
</script>
