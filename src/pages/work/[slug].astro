---
// Boards 5, 6 and 7 all say the same thing three times over:
// "Clickable Thumbnail. Takes user to new Page dedicated to this project."
// The spec has no per-project route. This is that route, wired as a
// labelled shell. Spec §7 commits to an anecdote per project in the beat
// 03 copy, and this page is where that promise gets kept.
import Scroll from '../../layouts/Scroll.astro';
import data from '../../data/projects.json';

export function getStaticPaths() {
  return data.projects.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}

const { p } = Astro.props;
const idx = data.projects.findIndex((x) => x.slug === p.slug);
const next = data.projects[(idx + 1) % data.projects.length];
---

{/* noindex until the copy exists — real URLs to share, but Google should
    never index a page of empty brackets. Ruled in (JJ, 2026-08-11).
    Pages with a written story (p.story) are index-eligible per that same
    logic: the brackets are gone. First one: Used To Know Me, 2026-08-17. */}
<Scroll dark={true} noindex={!p.story} title={`${p.title} — JJ House`} desc={`${p.title}. ${p.roles.join(', ')}.`}>
  <script is:inline>
    // Refresh-mid-overlay recovery (JJ, 2026-08-20). The overlay pushes
    // /work/slug with history.state.wo set, and that state SURVIVES a
    // reload — so landing here with it means the visitor refreshed while
    // the overlay was open, and this static page would strand them with
    // no scroll-out. Hand them back to the intended setup: the archive
    // underneath, the overlay on top (WorkOverlay boots from ?open=).
    // location.replace keeps this page out of history. A direct visit or
    // shared link has no state.wo and stays right here — the static page
    // is still the real, shareable, no-JS artifact (ruled 8/19).
    (function () {
      if (!(history.state && history.state.wo)) return;
      var m = location.pathname.match(/^\/work\/([\w-]+)\/?$/);
      if (m) location.replace('/work/?open=' + encodeURIComponent(m[1]));
    })();
  </script>
  <div class="pp">
    <a class="pp__back" href="/#work">&#8624; Back</a>

    <h1 class="pp__title">{p.title}</h1>

    <div class="pp__roles">
      {p.roles.map((r) => <span class="meta">{r}</span>)}
    </div>

    <!-- Facade embed: the still loads, the player only on request. Moves
         to self-hosted Mux per spec §1; until then youtube-nocookie /
         player.vimeo keep third-party weight off the first paint.
         p.video may be null (Field Journal's hero videos are still on JJ's
         external drive) — the page then runs text-first, no media block. -->
    {p.video && (
      <div class="pp__media" id="ppMedia" data-type={p.video.type} data-vid={p.video.id} data-title={p.title}>
        <img src={`/thumbs/${p.slug}.webp`} alt={`${p.title} — still`} width="1280" height="720" decoding="async" />
        <button class="pp__play" id="ppPlay">Play &#9654;</button>
      </div>
    )}

    <!-- Two shapes, per the dictation pipeline. p.story is the finished
         diary-prose memoir (array of paragraphs, sparing inline HTML for
         emphasis); until a project has one, the Spec §7 four-line scaffold
         holds the page: 40 to 60 words, ending on a call JJ made rather
         than on the chaos, conditions named as causes, never people. -->
    {p.story ? (
      <div class="prose pp__story">
        {p.story.map((par) => <p set:html={par} />)}
      </div>
    ) : (
      <dl class="pp__anecdote">
        <div class="pp__beat">
          <dt>what it was trying to be</dt>
          <dd>[ one line &mdash; JJ ]</dd>
        </div>
        <div class="pp__beat">
          <dt>what went wrong</dt>
          <dd>[ one line, dry, no self-pity ]</dd>
        </div>
        <div class="pp__beat">
          <dt>the call</dt>
          <dd>[ one line &mdash; load-bearing. The anecdote ends here, not on the chaos. ]</dd>
        </div>
        <div class="pp__beat">
          <dt>what it bought</dt>
          <dd>[ one line, result in it ]</dd>
        </div>
      </dl>
    )}

    {p.credits && <p class="meta pp__credits">{p.credits}</p>}

    <script is:inline>
      (function () {
        const m = document.getElementById('ppMedia');
        const btn = document.getElementById('ppPlay');
        if (!m || !btn) return;
        btn.addEventListener('click', () => {
          const id = m.dataset.vid;
          const src = m.dataset.type === 'youtube'
            ? `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`
            : `https://player.vimeo.com/video/${id}?autoplay=1`;
          const f = document.createElement('iframe');
          f.src = src;
          f.title = m.dataset.title || 'Video';
          f.allow = 'autoplay; fullscreen; picture-in-picture; encrypted-media';
          f.allowFullscreen = true;
          m.innerHTML = '';
          m.appendChild(f);
        });
      })();
    </script>

    <div class="pp__next">
      <a class="pp__back" href="/work">All work &#8627;</a>
      <a class="pp__back" href={`/work/${next.slug}`}>Next &mdash; {next.title} &rarr;</a>
    </div>
  </div>
</Scroll>
