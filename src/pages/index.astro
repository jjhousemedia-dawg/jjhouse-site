---
import Scroll from '../layouts/Scroll.astro';
import data from '../data/projects.json';
import Wordmark from '../components/Wordmark.astro';
import ConnectGate from '../components/ConnectGate.astro';
import WorkOverlay from '../components/WorkOverlay.astro';
import ClientLogos from '../components/ClientLogos.astro';

// --- beat 05 selection -------------------------------------------------
// PLACEHOLDER PICK, being replaced one slot at a time as the written
// stories land. 2026-08-20 (JJ): 'the-districts-outlaw-love' OUT,
// 'redondo-red-stories-to-tell' IN — it now carries a written story
// (JJ's note to Brendon), which Outlaw Love did not.
// Swap the remaining slugs when he confirms the real six.
const FEATURED = [
  'charli-xcx-used-to-know-me',
  'rufus-du-sol-music-is-better',
  'magdalena-bay-chaeri',
  'redondo-red-stories-to-tell',
  'finneas-cleats',
  'amiri-pacific-flat',
];

const bySlug = Object.fromEntries(data.projects.map((p) => [p.slug, p]));
const featured = FEATURED.map((s) => bySlug[s]).filter(Boolean);

// Little Dot gets its own beat. Figures are JJ's verified numbers.
const LDS = { channels: '15+', views: '5B+', subs: '5.1M' };

const sizes = ['project--l', 'project--r', 'project--xl', 'project--l', 'project--r', 'project--xl'];
---

<Scroll loader={true} title="JJ House — Creative Director & Producer" desc="JJ House. Creative director and producer in Los Angeles.">
  <!-- ================= 01 ARRIVAL ================= -->
  <header class="beat arrival" id="top">
    <div class="arrival__top">
      <div>
        <!-- 01-A trimmed to the plain clause 2026-08-17 (JJ): the second
             clause ("the part I own…") read as operations/AI-speak. A
             sensibility-forward second clause may return; workshop it with
             JJ, never draft-and-ship. -->
        <p class="arrival__deck">
          I work with brands and artists on films and campaigns.
        </p>
        <!-- Board 2 + noth.in both carry a CTA in the hero. The only CTA on the
             page was 9,700px down, for a hiring-manager audience. -->
        <p class="arrival__cta">
          <a class="btn" href="#comein"><span>Connect &rarr;</span></a>
        </p>
      </div>
    </div>

    <!-- Board 2. Surface minimal, substrate maximal. Drag to erode; it
         refills like foam closing over water. The canvas here is a 2D
         stand-in for the WebGL2 mask-reveal (decay ~0.94, stamp ~8vw,
         noise matched to hair scale). Substrate becomes Blender geo-nodes
         work, in colour, per spec §5. -->
    <!-- The ink layer spans the whole hero, NOT the wordmark box. That is the
         point of the reference: the letterforms are part of one sheet lying
         over the water, and the cursor shoves that sheet around, so torn ink
         has to be able to pile up well outside the letters. -->
    <canvas class="surface__erode" id="erode"></canvas>

    <div class="surface" id="surface">
      <div class="surface__substrate">
        <!-- The substrate: JJ's 70s Blender wordmark loop (2100f @ 30).
             Two lives at once. No WebGL2: it shows here directly, edge-faded
             by the CSS mask (method A). WebGL2: the div is opacity:0 but the
             video keeps playing and erode.js samples it every frame as the
             reveal texture, rect-mapped so its letters sit exactly under the
             SVG letters (frame width = mark width / 0.90, per the ortho cam's
             4.9256 scale). Codec order = first the browser can hardware-
             decode: AV1 10-bit, HEVC for Safari, H.264 floor. crossorigin
             keeps the WebGL texture untainted. -->
        <video class="substrate__video" muted loop autoplay playsinline preload="metadata"
               poster="/hero/house_wordmark_poster.jpg" crossorigin="anonymous" aria-hidden="true">
          <source src="/hero/house_wordmark_1080p_av1.mp4"  type='video/mp4; codecs="av01.0.08M.10"' />
          <source src="/hero/house_wordmark_1080p_hevc.mp4" type='video/mp4; codecs="hvc1"' />
          <source src="/hero/house_wordmark_1080p_h264.mp4" type="video/mp4" />
        </video>
      </div>
      <div class="wordmark__svg"><Wordmark /></div>
    </div>

    <!-- The two-finger hint is NOT a UI element (JJ, 2026-08-17: "the
         effect itself, in some sort of hinting way"). On touch devices the
         sim's ambient motion becomes periodic paired wisps — two thin
         parallel trails spaced like fingertips, brushing across the
         wordmark band every few seconds — so the sheet demonstrates the
         gesture in its own material. Lives in erode.js (TOUCHY branch of
         the drift). The earlier dots + "( two fingers )" label were cut
         same day for this. -->

    <div class="arrival__foot">
      <span class="meta">Creative direction &middot; Producing &middot; Los Angeles</span>
      <span class="meta"><a href="https://www.linkedin.com/in/jjhousemedia/" target="_blank" rel="noopener" style="color:inherit">LinkedIn</a> / <a href="https://www.instagram.com/jj.duplex/" style="color:inherit">Instagram</a> / <a href="/JJ-House-Resume-2026.pdf" target="_blank" style="color:inherit">Resume</a></span>
    </div>
  </header>

  <!-- 02 statement cut 2026-08-17 (JJ): "The work you deliver is never the
       work you pitched" removed entirely — his read was that it sat on its
       own island and didn't pull people down the page. What remains is his
       ask: about half a viewport of open paper for the hero's torn ink to
       run into (the erode canvas reaches past the hero on purpose) before
       the page hits the reel. -->
  <section class="beat beat--breather" aria-hidden="true"></section>

  <!-- 03 ASIDE cut 2026-08-17 (JJ): the (premise) paragraphs read as
       pessimistic rumination to a cold viewer. Text lives in git history;
       any return goes through JJ's rewrite, not a paste-back. -->

  <!-- ================= 04 REEL — the flip point ================= -->
  <section class="reel" id="reel">
    <!-- Board 9's environment, and it is a real render now: the hero still
         off the marsh scene (`ReelBG_hero_cleanenv_f257`, 5760x3240), not
         the perspective-grid stand-in. Plate, cast shadow and reel frame
         all live inside ONE sticky pin (.reel__pin — 2026-08-20 round 2),
         so they pin, hold and DEPART as a single unit: the reel can no
         longer scroll away ahead of the marsh once it has settled. The
         pin's real height is also the clamp that keeps the plate out of
         Works (no negative margins near sticky, ever — see scroll.css).

         The ladder is AVIF -> WebP -> JPEG at six widths; a 20px WebP is
         inlined as the background so something in the right colours paints
         before any rung arrives. `--plate-pos` is the crop anchor: 16:9
         art on a portrait phone has to lose something, and this is the
         knob that decides what. -->
    <div class="reel__pin">
      <div class="reel__stage" aria-hidden="true">
        <picture>
          <source type="image/avif" sizes="100vw" srcset="/reel-bg/marsh_day_640.avif 640w, /reel-bg/marsh_day_960.avif 960w, /reel-bg/marsh_day_1280.avif 1280w, /reel-bg/marsh_day_1920.avif 1920w, /reel-bg/marsh_day_2560.avif 2560w, /reel-bg/marsh_day_3840.avif 3840w" />
          <source type="image/webp" sizes="100vw" srcset="/reel-bg/marsh_day_640.webp 640w, /reel-bg/marsh_day_960.webp 960w, /reel-bg/marsh_day_1280.webp 1280w, /reel-bg/marsh_day_1920.webp 1920w, /reel-bg/marsh_day_2560.webp 2560w, /reel-bg/marsh_day_3840.webp 3840w" />
          <img
            class="reel__plate" alt="" decoding="async" loading="lazy" fetchpriority="low"
            src="/reel-bg/marsh_day_1920.jpg" sizes="100vw" srcset="/reel-bg/marsh_day_640.jpg 640w, /reel-bg/marsh_day_960.jpg 960w, /reel-bg/marsh_day_1280.jpg 1280w, /reel-bg/marsh_day_1920.jpg 1920w, /reel-bg/marsh_day_2560.jpg 2560w, /reel-bg/marsh_day_3840.jpg 3840w"
          />
        </picture>

        <!-- 2026-08-24 (JJ): the plate MOVES. `REELBG_MARSH_CONFORM_v01`
             is the same camera as the still above (framing verified: 6/255
             mean difference over the sky and the foreground), 1920x1080,
             exactly 720 frames at 24.000 fps — the same L as the reel, so
             the two native `loop` seams land on the same beat.

             ⛔ THIS PLATE IS CONFORMED TO THE REEL, and that is a hard
             sync requirement, not a nicety. The reel screen is held out of
             the render (§4.3 of the build spec) but its LIGHT is not: the
             colour running down the channel is the cut reflecting off the
             water. Measured over all 720 frames, the reflection's mean
             colour correlates with the reel's at r = 0.98, peaking at a
             lag of ONE FRAME — plate frame n carries reel frame n-1. Let
             the two videos free-run and they drift apart within a minute,
             and the water then reflects a shot that is not on screen. The
             drift-trim in the script below is what holds them together.

             The still stays underneath: it paints instantly, it is the
             poster, and it is the whole plate for prefers-reduced-motion
             and for no-JS. No `autoplay` attribute here on purpose —
             unlike the reel, this element has no useful scriptless
             behaviour, so JS owns playback outright and there is no race
             to lose. -->
        <video
          class="reel__plate reel__plate--vid" id="reelPlate"
          muted loop playsinline preload="metadata"
          disablepictureinpicture disableremoteplayback
        >
          <source src="/reel-bg/marsh_day_1080p.av1.mp4" type='video/mp4; codecs="av01.0.09M.10"' />
          <source src="/reel-bg/marsh_day_1080p.hevc.mp4" type='video/mp4; codecs="hvc1"' />
          <source src="/reel-bg/marsh_day_1080p.mp4" type="video/mp4" />
        </video>
      </div>

      <!-- The shadow the reel casts on its way in: an ellipse under the
           frame's bottom edge that rides the plate's foreground floor (the
           steps, the bed) and dissipates as the reel reaches the screen
           slot. Geometry is written per-frame by the recede loop; the
           material lives on .reel__shadow in scroll.css. -->
      <div class="reel__shadow" aria-hidden="true"></div>

      <!-- The Sound toggle (board 9) is OUT for now — ruled by JJ
           2026-08-20. It was already inert, and with a real reel under it
           a live-looking control that does nothing is worse than no
           control. The beat is silent until the 5-stem bed is wired, and
           the bed waits on the marsh: there is no backdrop variation yet
           to arrange against, so there is nothing for the stems to mark.
           Everything else survives — `.reel__sound` styling is still in
           scroll.css, reelbed.js is still in src/scripts, and the opus
           stems are still in public/reel-lab/audio. Bringing it back is
           this button plus a handler, not a rebuild. -->

      <!-- 2026-08-20 (JJ): the locked v04 cut, looping on the wall clock.

           ENTRY, re-ruled 2026-08-20 off another look at noth.in: the reel
           arrives at the FULL WIDTH OF THE PAGE and travels up with the
           document like any other block. It only pins, and only then starts
           receding, once the top of its own frame reaches the top of the
           window. The previous version centred it in a pinned panel at
           min(90%, 60rem) and began receding the moment the section did,
           so it never had a full-width moment at all.

           The shared `.reel__pin` (sticky, one viewport tall) IS that
           behaviour, exactly, with no scroll maths: below the fold it
           flows, at the fold it stops — and because the plate rides the
           same pin, reel and environment also LEAVE together when the hold
           runs out (JJ, 2026-08-20 round 2). The script only owns what
           comes after the pin.

           On PHONES the same beat starts one pose earlier (JJ, 2026-08-20
           mobile round): the frame arrives scaled to cover the viewport —
           the reel felt as a 9:16 video — and recedes straight back into
           the marsh from there. See --entry-cover in scroll.css and the
           start-pose maths in the loop below. -->
      <div class="reel__frame" id="reelFrame">
        <video
          class="reel__video" id="reelVideo"
          poster="/reel/reel_v04_poster.jpg"
          muted loop playsinline autoplay preload="metadata"
          disablepictureinpicture disableremoteplayback
        >
          <source src="/reel/reel_v04_1080p.av1.mp4" type='video/mp4; codecs="av01.0.09M.10"' />
          <source src="/reel/reel_v04_1080p.hevc.mp4" type='video/mp4; codecs="hvc1"' />
          <source src="/reel/reel_v04_1080p.mp4" type="video/mp4" />
        </video>

        <!-- No page-space reflection any more (cut 2026-08-20, JJ): the
             marsh render carries the physically-accurate one in its water,
             and the canvas mirror argued with it. When the video backdrop
             lands, the rendered reflection (raw + k·REEL lightgroup pass)
             gets an animated mask reveal timed to the recede, so it
             appears as the reel goes deeper into the scene. -->
      </div>
    </div>

    <!-- The scroll the recede spends, as a real element.

         TRAP, and it cost a test run: `padding-bottom` on the section does
         NOT do this. A sticky element is constrained to its containing
         block, which is its parent's CONTENT box — padding is outside it,
         so the frame's pin range came out as zero and it simply scrolled
         away while the recede was still easing. Symptom to recognise: the
         frame's untransformed top tracks scroll exactly (top === -offset)
         and the scale never reaches its floor. A spacer is content, so the
         range is unambiguous. -->
    <div class="reel__hold" aria-hidden="true"></div>

    <!-- 04-A: a line sits here beside the reel, without any house wordplay
         (ruled 2026-08-11). JJ's words to come — no visible placeholder in
         the meantime (dev notes stripped from previews 2026-08-17). -->
  </section>

  <!-- ================= 05 WORK ================= -->
  <section class="beat" id="work">
    <!-- Board 5, verified live on noth.in: the word is whole and large at
         entry, its letters scatter across the header mid-section, then it
         splits W | ORKS and reassembles small. Scroll-driven, not timed. -->
    <div class="worksmark" aria-hidden="true">
      <div class="worksmark__row" id="worksRow">
        <span class="worksmark__l">W</span><span class="worksmark__l">O</span><span
          class="worksmark__l">R</span><span class="worksmark__l">K</span><span
          class="worksmark__l">S</span>
      </div>
    </div>

    <div class="ticker">
      <span class="ticker__slot" id="tickerSlot">WORKS</span>
    </div>

    <div class="beat__inner">
      <div class="projects">
        {featured.map((p, i) => (
          <article class={`project ${sizes[i % sizes.length]}`} data-rise data-roles={p.roles.join('|')}>
            <a class="project__link" href={`/work/${p.slug}`}>
              <div class="project__media">
                <img
                  src={`/thumbs/${p.slug}.webp`}
                  alt={`${p.title} — still`}
                  width="1280" height="720"
                  loading={i < 2 ? 'eager' : 'lazy'}
                  decoding="async"
                />
              </div>
              <h2 class="project__title">{p.title}</h2>
              <span class="project__go">Open project &#8627;</span>
            </a>
            <div class="project__roles">
              {p.roles.map((r) => <span class="meta">{r}</span>)}
            </div>
            {p.anecdote && <p class="project__note">{p.anecdote}</p>}
          </article>
        ))}
      </div>

      <p class="viewall" data-rise><a href="/work">View all &#8627;</a></p>
    </div>
  </section>

  <!-- Featured cards open in the work overlay (WorkOverlay.astro, the
       sixnfive step-in / scroll-out, 2026-08-19). The hrefs stay real
       /work/ pages — no JS, no overlay, same destination. -->
  <WorkOverlay />

  <!-- ================= 06 LITTLE DOT ================= -->
  <section class="beat">
    <!-- Little Dot framing still open (06-C). JJ's direction 2026-08-17:
         straightforward over blanket-summary — likely its own works-style
         story built from a few specific things he makes there, plus visuals
         and maybe links. Label "( the other half )" cut per JJ. -->
    <div class="beat__inner" data-rise>
      <!-- "Not everything I make is a film." → JJ's direction 2026-08-17:
           straightforward, "digital agency work or something like that." -->
      <h2 class="statement">Digital agency work.</h2>
      <!-- "at Little Dot Studios" added 2026-08-20 per JJ ("worth figuring
           out the copy and clarifying that I work at Little Dot Studios").
           Kept to the minimum factual insertion; he iterates copy at word
           level, so anything beyond naming the studio waits for him. -->
      <div class="prose" style="margin-top:2.5rem">
        <p>
          {LDS.channels} brand and creator channels at Little Dot Studios. {LDS.views} views and
          {LDS.subs} subscribers across the tenure. Love Island packaging, Pokemon, originals
          programmed and written and thumbnailed.
        </p>
      </div>
      <ClientLogos />
    </div>
  </section>

  <!-- ================= 07 HOW I WORK ================= -->
  <section class="beat" id="how">
    <div class="beat__inner" data-rise>
      <p class="label">( how i work )</p>
      <!-- JJ's own two-liner, 2026-08-17, verbatim (lowercase open and
           no closing punctuation on line one are his — do not normalize
           without asking). Note "frame a project", not "frame this". -->
      <div class="principles">
        <!-- Round 9, 2026-08-18. Skarlett: "I don't know where to look first."
             These were two identical .principle blocks with a 4.5rem gap
             between them — set as twins, so the eye had no entry point and
             the weaker line read first. But it is ONE sentence in two moves:
             a throwaway dismissal, then the line that actually matters. So
             the setup is demoted and pulled close, and the quote carries the
             weight. All lowercase per JJ 8/18; wording still his, verbatim. -->
        <div class="principle-group">
          <p class="principle__aside">
            instead of yapping on &lsquo;unique&rsquo; and &lsquo;authentic&rsquo;
          </p>
          <p class="principle principle--quote">
            <span class="principle__u">i prefer, &ldquo;how do we position and frame a project</span>
            <span class="principle__u">so it becomes what it&rsquo;s trying to be?&rdquo;</span>
          </p>
        </div>
      </div>

      <!-- Board 11's skills list was wired here; JJ ruled it out 2026-08-11.
           The prose carries the argument alone. -->
    </div>
  </section>

  <!-- 07b MORPH and 08 NOW cut 2026-08-17 (JJ) per the 8/14 ship plan:
       both were pure wireframe with no written copy. Markup in git history. -->

  <!-- ================= 09 COME IN ================= -->
  <footer class="beat" id="comein">
    <div class="beat__inner" data-rise>
      <p class="label">( connect )</p>
      <!-- "Tell me what you can already see." cut 2026-08-17 (JJ): not
           saying anything, causing confusion. Closing line TBD with JJ. -->
      <!-- "Connect" section, ruled 2026-08-17 (JJ): two options — request a
           connection, or just send an email. The connection button goes to
           JJ's "Connect With JJ" Google Calendar booking page (short link;
           deliberately a link, not the Google iframe/button embed, which
           would put a blue Google widget inside the b/w system — same
           third-party-weight philosophy as the facade video embeds). -->
      <!-- 2026-08-18, Skarlett: "that's a dangerous button." A public booking
           link shows the whole calendar to anyone who finds the site. Two
           doors instead of one gate — "Email me" stays open to everybody, the
           calendar asks for a code word. The URL is encrypted into the
           component and is NOT in the built bundle; see ConnectGate.astro. -->
      <ConnectGate />
      <!-- The S in the closing mark is the way back up (JJ, 2026-08-20):
           hover hints the coil, press compresses it, release fires the
           spring while the page rides the same tape-rewind the anchor
           links already use. On touch, a slow idle spring every few
           seconds does the inviting instead (CSS, hover: none). No
           caption, deliberately — curiosity is the label. The hit area is
           an invisible <a href="#top"> over the S's slice of the drawing,
           so with JS off it is still an ordinary jump-to-top link; the
           layout's anchor handler carries the Lenis scroll, and the
           inline script below only owns the spring. -->
      <div class="closing-mark" data-chev="sweep">
        <a class="smark" id="sTop" href="#top" aria-label="Back to top" draggable="false"></a>
        <!-- Round 6 (JJ): while the S tenses under the cursor, chevrons
             surface above it pointing up, and a light climbs them. That
             light was a dash chasing each rim; re-cut 2026-08-21 into
             three upward treatments (sweep / relay / ghost, ?chev=), all
             of which quicken while the S is pressed. See scroll.css.
             Decorative; the .smark link carries the semantics.
             The <defs> feed the default "sweep": a gradient band inside
             a mask, translated upward across both rims. Its ids are
             document-global, so this markup may exist only once. -->
        <svg class="schev" viewBox="0 0 60 44" aria-hidden="true">
          <defs>
            <!-- The band, softened 2026-08-21 (JJ/ "a little more of a
                 gradient on the sweep"). The white plateau is now barely a
                 sliver and the ramps run most of the band, with a mid stop
                 at each end so the falloff reads long rather than linear.
                 The rect grew 34 -> 46 units to carry it; chev-sweep's
                 travel in scroll.css is sized off that height. -->
            <linearGradient id="schevBand" x1="0" y1="1" x2="0" y2="0">
              <stop offset="0" stop-color="#000" />
              <stop offset="0.20" stop-color="#3a3a3a" />
              <stop offset="0.44" stop-color="#fff" />
              <stop offset="0.58" stop-color="#fff" />
              <stop offset="0.80" stop-color="#3a3a3a" />
              <stop offset="1" stop-color="#000" />
            </linearGradient>
            <mask id="schevSweep" style="color-interpolation:sRGB" maskUnits="userSpaceOnUse" x="-12" y="-48" width="84" height="150">
              <rect class="schev__band" x="-12" y="44" width="84" height="46" fill="url(#schevBand)" />
            </mask>
          </defs>
          <path class="schev__p" d="M10 40 30 24 50 40" />
          <path class="schev__p" d="M10 24 30 8 50 24" />
          <g class="schev__sweep" mask="url(#schevSweep)">
            <path d="M10 40 30 24 50 40" />
            <path d="M10 24 30 8 50 24" />
          </g>
          <path class="schev__c" d="M10 40 30 24 50 40" />
          <path class="schev__c schev__c--b" d="M10 24 30 8 50 24" />
          <path class="schev__g" d="M10 40 30 24 50 40" />
        </svg>
        <!-- The nudge (JJ, 2026-08-29): a hand-drawn arrow coming down
             from the upper left into the S, so the back-to-top spring
             gets pointed at without getting captioned. It is one of JJ's
             own post-it arrows from the retired concept, mirrored and
             turned; drawn as a mask so it takes currentColor. Inert and
             hidden from assistive tech — the .smark link above carries
             every bit of the semantics. See .shint in scroll.css. -->
        <span class="shint" aria-hidden="true"></span>
        <Wordmark />
      </div>
    </div>
    <div class="colophon">
      <span class="meta">&copy; 2026 JJ House &middot; Los Angeles</span>
      <!-- Site colophon, ruled 2026-08-22 (JJ): the site gets a credits
           line in the SAME grammar as every project page — crew first,
           "JJ House:" last with the roles after the colon. It reads as
           the credits form the reader has already seen fourteen times,
           not as a claim. Deliberately NOT "designed & built by": that
           is web-developer convention and muddies the offer. -->
      <span class="meta">astro &middot; lenis &middot; blender &middot; JJ House: design + build</span>
      <span class="meta">
        <a href="https://www.imdb.com/name/nm7420692/" style="color:inherit">IMDb</a> /
        <a href="https://www.instagram.com/jj.duplex/" style="color:inherit">Instagram</a>
      </span>
    </div>
  </footer>

  <script>
    // WebGL2 wordmark erosion. If it cannot start (no WebGL2, reduced
    // motion, shader failure) the DOM text simply stays visible and
    // nothing else on the page changes.
    import { initErode } from '../scripts/erode.js';
    const surface = document.getElementById('surface');
    if (surface) {
      let ok = false;
      try { ok = initErode(surface); } catch (err) { console.error('[erode]', err); }
      if (ok) surface.classList.add('is-canvas');
    }

    // Every visit drops into the loop at a random point (JJ, 2026-08-18),
    // so no two arrivals meet the same material. Runs in BOTH paths — the
    // WebGL texture and the no-WebGL fallback read the same element. Safe
    // with the loop: the 0/end seam is seamless (verified against the
    // source EXRs), so a start at 41s just plays 41->70->0->... forever.
    // Seeks land keyframe-accurate (keyint 120 = 4s GOPs, faststart), and
    // Vercel serves range requests, so the browser fetches from the seek
    // point rather than the whole head of the file.
    const sv = document.querySelector('video.substrate__video');
    if (sv) {
      const randomize = () => {
        if (sv.duration && isFinite(sv.duration)) sv.currentTime = Math.random() * sv.duration;
      };
      if (sv.readyState >= 1) randomize();
      else sv.addEventListener('loadedmetadata', randomize, { once: true });
    }
  </script>

  <script is:inline>
    (function () {
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // ---- the flip point. Ruled by JJ 2026-08-17: strictly positional. ----
      // Both directions, no one-way latch. Evaluated on load, scroll,
      // resize, and pageshow so a refresh mid-page or a back/forward return
      // can never strand the page in the wrong mode (the old one-way
      // IntersectionObserver did exactly that when scroll restoration
      // landed past the reel).
      //
      // WHERE it flips, re-re-ruled 2026-08-20 round 5 (JJ): MID-RECEDE,
      // at --flip-at of the travel (0.45). Round 4 flipped at settle, but
      // on a phone the URL bar collapses and the visible viewport grows
      // past the 100svh pin, so a strip of page background peeks below the
      // plate and JJ could still feel the crossfade there at the bottom of
      // the screen late in the beat. Flipping while the reel is still
      // receding puts the fade inside the beat's own motion, and by the
      // hold it is long finished in both the plate and the strip. The
      // recede loop hands the distance over via flipPx (it already knows
      // travel, including ?travel=); ?flip= tunes the fraction from any
      // preview URL. The midpoint rule stays as the reduced-motion
      // fallback, where there is no recede.
      const reel = document.getElementById('reel');
      let flipPx = null;   // set by the recede loop's measure()
      let setTheme = () => {};
      if (reel) {
        setTheme = () => {
          const r = reel.getBoundingClientRect();
          const dark = flipPx != null
            ? -r.top >= flipPx
            : r.top + r.height / 2 <= window.innerHeight / 2;
          document.body.classList.toggle('is-dark', dark);
        };
        addEventListener('scroll', setTheme, { passive: true });
        addEventListener('resize', setTheme);
        addEventListener('pageshow', setTheme);
        setTheme();
      }

      // ---- the reel recedes, but only AFTER it has pinned ----------
      // Re-ruled 2026-08-20 (JJ, off noth.in): the reel is full page width
      // on arrival and stays that way until the top of its frame reaches
      // the top of the window. CSS `position: sticky; top: 0` does the
      // arriving and the pinning; this loop owns only what happens after,
      // and its clock is `-r.top` — how far the section's top has travelled
      // past the fold, which is EXACTLY how far the frame has been pinned,
      // because the frame's static position is the section's top. Before
      // the pin that number is negative, so p clamps to 0 and the reel is
      // untouched at full width. No separate "has it pinned yet" state to
      // keep in sync with the browser's.
      //
      // rAF + lerp, NOT scroll events + a CSS transition. The old shape
      // (write --recede per scroll event, let `transition: transform 120ms
      // linear` chase it) stuttered badly on phones: momentum scrolling
      // delivers scroll events in irregular bursts, so the transition kept
      // restarting toward stale targets — visible as the jagged crop-in JJ
      // flagged 2026-08-17.
      const frame = document.getElementById('reelFrame');
      if (frame && reel && !reduce) {
        let cur = 0, raf = null, idle = 0;
        // read once per resize, not per frame: all are media-query values
        let travel = 0, svh = 0, sEnd = 0.34, dxEnd = 0, yEnd = 0, line = 0, cover = 0, exitE = 0, gapPx = 0;
        const stage = reel.querySelector('.reel__stage');
        const shadow = reel.querySelector('.reel__shadow');
        const pin = reel.querySelector('.reel__pin');
        const pic = frame.querySelector('.reel__video');
        const AR = 16 / 9;   // the plate's aspect (5760x3240 render)
        const measure = () => {
          const cs = getComputedStyle(frame);
          // the Blender screen slot, as fractions of the PLATE IMAGE —
          // measured off the v023 passB matte; see .reel__frame in scroll.css
          let sw = parseFloat(cs.getPropertyValue('--screen-w')) || 0.3413;
          let sx = parseFloat(cs.getPropertyValue('--screen-x')) || 0.5;
          let sy = parseFloat(cs.getPropertyValue('--screen-y')) || 0.4546;
          let cap = parseFloat(cs.getPropertyValue('--recede-cap')) || 1;
          line = parseFloat(cs.getPropertyValue('--frame-line')) || 0;
          // --entry-cover: how much of the viewport the frame fills at the
          // START of the beat. 0 (desktop) = the noth.in full-width entry,
          // untouched. 1 (phones) = the frame arrives scaled to COVER the
          // pin — a 9:16 centre-crop of the 16:9 cut, the reel felt as a
          // portrait video — and the recede pulls it straight back out of
          // that into the marsh. Unitless, like every knob here.
          cover = parseFloat(cs.getPropertyValue('--entry-cover')) || 0;
          // ⛔ --recede-travel is a UNITLESS MULTIPLIER, deliberately.
          // getComputedStyle hands back custom properties as raw tokens, so
          // a value of `100svh` parseFloats to 100 and the recede finished
          // in a hundred pixels of scroll. It read as a snap rather than a
          // move, and nothing threw. Never put a CSS length in a custom
          // property that JS is going to do arithmetic on.
          //
          // The viewport height comes off the STAGE, which CSS sizes at
          // 100svh — svh and not innerHeight, because on phones the URL bar
          // showing and hiding changes innerHeight mid-scroll and used to
          // make the scale jump.
          svh = (stage && stage.offsetHeight) || window.innerHeight;
          travel = svh * (parseFloat(cs.getPropertyValue('--recede-travel')) || 1);
          exitE = svh * (parseFloat(cs.getPropertyValue('--exit-ease')) || 0);
          // The locked dwell between the recede finishing and the ramp
          // starting (JJ, 2026-08-21). Unitless viewport multiple, like
          // everything else here.
          gapPx = svh * (parseFloat(cs.getPropertyValue('--exit-gap')) || 0);

          // Live-tunable from any preview URL while JJ settles the numbers,
          // same deal as the touch-ink factors in erode.js: ?sw= (slot
          // width, image fraction) &sy= (slot bottom edge, image fraction)
          // &cap= &travel= &bw= (frame line, visual px). Bake the winners
          // into scroll.css when he calls them.
          const q = new URLSearchParams(location.search);
          if (q.has('sw'))     sw     = parseFloat(q.get('sw'))     || sw;
          if (q.has('sy'))     sy     = parseFloat(q.get('sy'))     || sy;
          if (q.has('cap'))    cap    = parseFloat(q.get('cap'))    || cap;
          if (q.has('travel')) travel = svh * (parseFloat(q.get('travel')) || 1);
          if (q.has('bw'))     line   = parseFloat(q.get('bw'))     || line;
          if (q.has('cover'))  { const v = parseFloat(q.get('cover')); if (isFinite(v)) cover = v; }
          if (q.has('exit'))   { const v = parseFloat(q.get('exit'));  if (isFinite(v)) exitE = svh * v; }
          if (q.has('gap'))    { const v = parseFloat(q.get('gap'));   if (isFinite(v)) gapPx = svh * v; }

          // Project the slot through the plate's cover-crop, so the settled
          // reel matches the Blender construction at ANY viewport:
          // object-fit: cover at 50%/50% draws the 16:9 plate at
          // max(page width, svh·AR) wide and centres the overflow, so a
          // feature at image-fraction (fx, fy) renders at ox + fx·dw,
          // oy + fy·dh. The cap keeps portrait phones sane — their crop
          // can blow the slot up wider than the page itself.
          const pw = frame.offsetWidth || window.innerWidth;
          const dw = Math.max(pw, svh * AR), dh = dw / AR;
          const ox = (pw - dw) / 2, oy = (svh - dh) / 2;
          sEnd  = Math.min((sw * dw) / pw, cap);   // settled scale of the full-width frame
          dxEnd = ox + sx * dw - pw / 2;           // 0 while the slot is centred
          yEnd  = oy + sy * dh;                    // settled BOTTOM edge of the picture

          // hand the flip distance to the theme script: dark mid-recede
          // (JJ, round 5), while the beat's own motion carries the fade
          const flipAt = q.has('flip') ? (parseFloat(q.get('flip')) || 0.45) : 0.45;
          flipPx = travel * flipAt;
          setTheme();
        };
        const tick = () => {
          const r = reel.getBoundingClientRect();
          const target = Math.min(1, Math.max(0, -r.top / travel));
          cur += (target - cur) * 0.16;
          if (Math.abs(target - cur) < 0.0004) { cur = target; idle++; } else { idle = 0; }
          const F = frame.offsetHeight;
          const V = (pic && pic.offsetHeight) || F;
          // THE START (JJ, 2026-08-20 mobile round): the old start was
          // scale 1 / translate 0 — full width, top of the pin — which on
          // a phone is a short strip at the TOP of the screen that then
          // shrinks and slides DOWN to the slot: it read as falling, not
          // receding. Now the start pose is its own keyframe: scaled to
          // cover the pin (s0) and centred in it (dy0), and the recede
          // lerps pose-to-pose on one clock, so the reel pulls straight
          // back off the glass into the scene. cover = 0 collapses s0 to
          // 1 and dy0 to 0: the desktop entry, bit-for-bit.
          const s0  = 1 + Math.max(0, svh / F - 1) * cover;
          const dy0 = ((svh - F) / 2) * cover;
          const s = s0 + (sEnd - s0) * cur;        // current scale
          frame.style.setProperty('--recede', String(s));
          // The frame sits at the pin's top and scales about its own
          // centre, so the picture's bottom edge sits at F/2 + (V - F/2)·s
          // plus the translate. Solve for the translate that rests that
          // edge on the Blender slot's bottom edge (yEnd) and walk there
          // on the same eased clock as the scale. Applied left of scale()
          // in the transform list, so the offset is in real pixels and
          // does not shrink with it.
          const dyEnd = yEnd - F / 2 - (V - F / 2) * sEnd;
          const dy = dy0 + (dyEnd - dy0) * cur;
          frame.style.setProperty('--reeldy', dy.toFixed(1) + 'px');
          frame.style.setProperty('--reeldx', (dxEnd * cur).toFixed(1) + 'px');

          // The frame line: eased in with the recede (full-bleed carries
          // none), counter-scaled so it holds a constant visual width at
          // every scale. outline, not border — no layout under the maths.
          frame.style.setProperty('--bw', ((line * cur) / s).toFixed(2) + 'px');

          // The cast shadow. Its centre hugs the picture's current bottom
          // edge, so it rides the plate's foreground floor — the steps and
          // the bed — while the reel crosses them. Width tracks the reel;
          // opacity is a bump (peak mid-crossing): nothing while the reel
          // is full-bleed, gone again by the time it reaches the slot,
          // where the rendered water reflection takes over.
          if (shadow) {
            const bottomNow = dy + F / 2 + (V - F / 2) * s;
            const shw = (pic ? pic.offsetWidth : frame.offsetWidth) * s * 0.92;
            const shh = Math.max(12, shw * 0.10);
            shadow.style.setProperty('--shw', shw.toFixed(1) + 'px');
            shadow.style.setProperty('--shh', shh.toFixed(1) + 'px');
            shadow.style.setProperty('--shy', (bottomNow - shh * 0.4).toFixed(1) + 'px');
            shadow.style.setProperty('--sho', (1.8 * cur * (1 - cur)).toFixed(3));
          }

          // THE DEPARTURE RAMP (JJ, 2026-08-20 round 6: the un-pin "snaps
          // back" and the page jumps). The sticky release is a velocity
          // step: the pinned beat shows 0 px/s of motion through the
          // dwell, then full scroll speed the instant the clamp lets go.
          // Over the last exitE px of the hold, slide the WHOLE pin up by
          // (exitE/2)·q² where q is progress through that zone: the
          // derivative w.r.t. scroll is exactly q, so visible speed ramps
          // 0 -> 1 and MATCHES document speed at the release — no cut,
          // and scroll-driven, so it reverses perfectly. Past release the
          // offset holds at exitE/2; the strip it opens under the plate
          // is plain ink (the flip is long done), and Works' own top
          // padding swallows the seam. Transform, never margin: the
          // sticky clamp holds the margin box (the old marsh-into-Works
          // bug), but a transform is applied after clamping.
          //
          // ⭐ 2026-08-21 (JJ: "the page scrolls up a tad while the reel is
          // still receding"). The ramp used to start at a fixed
          // release - exitE, which on BOTH layouts fell INSIDE the recede
          // — desktop 0.90svh vs a recede ending at 1.00, phone 0.65 vs
          // 0.70 — so the pin, and with it the plate's framing, crept up
          // under a reel that had not landed yet. The start is now clamped
          // to whichever comes LATER: the ramp's own length, or the recede
          // plus the locked dwell (--exit-gap). E is re-derived from the
          // zone that actually remains, which keeps the slope identity
          // intact — d/dx of -0.5·E·q² is -q, so visible speed still ramps
          // 0 -> 1 and meets document speed exactly at the release, for
          // any E. If the hold is ever tuned so short that nothing is
          // left, E goes <= 0 and the ramp simply sits out; the framing
          // stays locked, which is the half that matters.
          if (pin) {
            const release = r.height - svh;   // where the pin would un-pin
            const startAt = Math.min(release, Math.max(release - exitE, travel + gapPx));
            const E = release - startAt;
            const zq = E > 0 ? Math.min(1, Math.max(0, (-r.top - startAt) / E)) : 0;
            pin.style.transform = zq > 0
              ? 'translate3d(0, ' + (-0.5 * E * zq * zq).toFixed(1) + 'px, 0)'
              : '';
          }
          if (idle > 20) { raf = null; return; }   // settled — sleep until the next scroll
          raf = requestAnimationFrame(tick);
        };
        const wake = () => { if (!raf) raf = requestAnimationFrame(tick); };
        addEventListener('scroll', wake, { passive: true });
        addEventListener('resize', () => { measure(); wake(); });
        measure();
        wake();
      }

      // ---- the credit ticker: CUT 2026-08-17 (JJ). ----
      // The per-project role cycling ("the flashing between Produce, VFX +
      // Edit") wasn't working for him. The slot now just says WORKS. Do not
      // resurrect the flicker; the roles already sit on each card.

      // ---- board 5: the WORKS letters migrate ----------------------
      // Whole and large on entry, scattered across the header at the
      // midpoint, split W | ORKS and small on exit. Driven by scroll
      // position through the work section, so it reverses on scroll up.
      const row = document.getElementById('worksRow');
      const workSec = document.getElementById('work');
      if (row && workSec && !reduce) {
        const letters = [...row.querySelectorAll('.worksmark__l')];
        const n = letters.length;
        const lerp = (a, b, f) => a + (b - a) * f;
        const ease = (x) => (x < 0.5 ? 2 * x * x : 1 - Math.pow(-2 * x + 2, 2) / 2);

        const place = () => {
          const r = workSec.getBoundingClientRect();
          const span = r.height - window.innerHeight;
          if (span <= 0) return;
          const p = Math.min(1, Math.max(0, -r.top / span));
          const W = row.clientWidth || 1;

          // Watermark scale, behind content. 104px is the desktop size; on
          // phones the clustered entry (~4.1 letter-widths) overflowed the
          // right edge, so the big size shrinks until the whole word fits
          // the row. Small size follows so the split end state fits too.
          const bigPx = Math.min(104, W / 4.4);
          const smallPx = Math.min(26, W / 14);
          letters.forEach((el, i) => {
            // three keyframes: clustered left, scattered, split
            const startX = i * bigPx * 0.78;
            const midX = (i / (n - 1)) * (W - smallPx * 2);
            const endX = i === 0 ? 0 : W - (n - i) * smallPx * 0.95 - 4;

            let x, fs;
            if (p < 0.5) {
              const f = ease(p / 0.5);
              x = lerp(startX, midX, f);
              fs = lerp(bigPx, smallPx + 4, f);
            } else {
              const f = ease((p - 0.5) / 0.5);
              x = lerp(midX, endX, f);
              fs = lerp(smallPx + 4, smallPx, f);
            }
            el.style.transform = `translateX(${x}px)`;
            el.style.fontSize = fs + 'px';
            // ghost register: present, never competing with the words on top
            el.style.opacity = String(0.10 + 0.10 * (1 - Math.abs(0.5 - p) * 2));
          });
        };
        addEventListener('scroll', place, { passive: true });
        addEventListener('resize', place);
        place();
      }

      // (board 9 sound toggle removed 2026-08-20 with its button — the
      // reel beat is silent until the bed is wired. See the markup above.)

      // ---- the reel: the locked v04 cut, looping on the wall clock ----
      // The scroll-scrub rig that used to live here is GONE. It mapped
      // scroll position onto currentTime, which meant the cut only moved
      // while you did — you could never actually watch it. Ruled
      // 2026-08-19 on /reel-lab: the reel runs on AMBIENT time, a wall
      // clock that always advances and is never scrubbed. Scroll's whole
      // budget in this beat is the recede above (and, later, the eclipse
      // dial behind). L = 720 frames = 30.000s; the file is cut to exactly
      // 720 frames so the native `loop` seam lands on the beat.
      const rv = document.getElementById('reelVideo');
      const pv = document.getElementById('reelPlate');
      if (rv) {
        // Decode is not free and this beat sits well below the fold, so
        // the reel only runs while it is near the viewport (rootMargin
        // below), and it is already at speed on arrival instead of
        // flashing its poster.
        //
        // The markup carries `autoplay` so the reel still runs if this script
        // never does. The moment it DOES run, JS takes ownership — otherwise
        // the two race: the observer's first callback can land while the
        // video is still paused (so its pause() is a no-op), and the autoplay
        // algorithm then starts playback with nothing left to stop it. Caught
        // as a flaky headless failure, which is the only way this shows up.
        rv.autoplay = false;

        let near = false;
        const want = () => !reduce && near && document.visibilityState !== 'hidden';

        // (The canvas-mirror reflection that lived here was cut 2026-08-20
        // with its element — the marsh render owns the reflection now. The
        // TRAP it documented still generalises: anything gated on the same
        // state as playback must be re-evaluated wherever that state is
        // written, not only where playback changes — which is why apply()
        // hangs off the observer, visibilitychange AND the play listener.)
        // ---- the marsh plate rides the reel's clock (JJ, 2026-08-24) --
        // The backdrop is conformed to this cut: the colour running down
        // the channel is the reel reflecting off the water, held out of
        // the render as geometry but not as light. So the two are one
        // shot, and they have to be played as one.
        //
        // What they will NOT do is stay together on their own. Two <video>
        // elements have two decoders and two ideas of the wall clock, and
        // the drift is unbounded — within a minute the water is reflecting
        // a shot that left the screen, which is worse than no reflection
        // because it looks like a bug rather than a choice.
        //
        // LAG is measured, not guessed: cross-correlating the reflection's
        // mean colour against the reel's, over all 720 frames, peaks at
        // r = 0.98 with the plate exactly ONE FRAME behind the reel.
        // L is the loop both files are cut to — 720 frames at 24.000 fps.
        const L = 30, LAG = 1 / 24;
        // Signed shortest distance around a 30s ring. Straight subtraction
        // reads a loop seam crossed by one video and not yet by the other
        // as ~30s of error and would seek on every single lap.
        const skew = () => {
          const d = (pv.currentTime - rv.currentTime - LAG) % L;
          return d > L / 2 ? d - L : d < -L / 2 ? d + L : d;
        };
        const seat = () => { if (pv.readyState >= 1) pv.currentTime = (rv.currentTime + LAG) % L; };
        // A seek is a visible hitch AND it lands late — the reel keeps
        // playing through it, so correcting by seeking overshoots by
        // however long the seek took. So seeking is reserved for real
        // desync (a backgrounded tab, a stalled decode) and everything
        // else is trimmed with playbackRate, proportionally: 1s of error
        // closes in about seven seconds at a rate the eye cannot see on
        // water with no hard edge moving through it. The deadband is two
        // frames, wide enough that the rate is not being rewritten on
        // every tick over rounding noise.
        const trim = () => {
          if (!pv || pv.paused || rv.paused || pv.readyState < 2 || rv.readyState < 2) return;
          const d = skew();
          if (Math.abs(d) > 2) { seat(); pv.playbackRate = 1; return; }
          const want = Math.abs(d) < 1 / 12 ? 1 : Math.min(1.15, Math.max(0.85, 1 - d * 0.15));
          if (Math.abs(pv.playbackRate - want) > 0.005) pv.playbackRate = want;
        };

        const apply = () => {
          if (want()) {
            const pr = rv.play(); if (pr && pr.catch) pr.catch(() => {});
            if (pv) { seat(); const pp = pv.play(); if (pp && pp.catch) pp.catch(() => {}); }
          } else {
            if (!rv.paused) rv.pause();
            if (pv && !pv.paused) pv.pause();
          }
        };
        // Half a viewport of lead, so the videos are at speed on arrival
        // rather than flashing a poster — but MEASURED, not a constant.
        //
        // ⛔ 2026-08-24: the constant `50%` had quietly stopped working.
        // The beat now begins 150svh down the document, so an expanded
        // root reaching half a viewport past the fold already contains the
        // reel AT SCROLL ZERO — it was decoding 1080p behind the hero's
        // WebGL erode for the entire top of the page, and with the marsh
        // plate added that is two decodes, not one. Nothing about it is
        // visible; it only shows up as a hot fan on the landing screen.
        //
        // So the lead is capped at whatever distance still leaves the reel
        // outside the root at rest. It asks for half a viewport and takes
        // less if the beat sits closer than that, which keeps the property
        // true no matter how the beats above it are re-cut later.
        const docTop = rv.getBoundingClientRect().top + (window.scrollY || 0);
        const lead = Math.max(0, Math.min(innerHeight * 0.5, docTop - innerHeight - 1));
        if ('IntersectionObserver' in window) {
          new IntersectionObserver(
            (es) => { near = es.some((e) => e.isIntersecting); apply(); },
            { rootMargin: `${Math.round(lead)}px 0px` }
          ).observe(rv);
        } else { near = true; apply(); }
        addEventListener('visibilitychange', apply);
        // the second half of the same guard: if playback starts when it is
        // not wanted (a stray autoplay, a restored session), undo it
        rv.addEventListener('play', () => { if (!want()) rv.pause(); });

        if (pv) {
          // fade in on the first REAL frame, not on `play` — the still
          // underneath is the cleanenv render with no screen light in the
          // channel, so revealing an undecoded video would flash ink
          pv.addEventListener('playing', () => pv.classList.add('is-live'), { once: true });
          pv.addEventListener('play', () => { if (!want()) pv.pause(); });
          // a quarter-second tick: far tighter than drift accumulates, and
          // trim() costs two readyState reads when nothing is playing
          setInterval(trim, 250);
        }

        // prefers-reduced-motion: a 24-shot cut running at half-bar pace
        // is exactly what that setting exists to stop. Poster only, and a
        // click starts it for anyone who does want to watch.
        if (reduce) {
          rv.removeAttribute('autoplay');
          rv.pause();
          rv.style.cursor = 'pointer';
          rv.addEventListener('click', () => { if (rv.paused) rv.play(); else rv.pause(); });
        }
      }

      // ---- the S fires you back to the top (JJ, 2026-08-20) ----------
      // The scroll itself belongs to the layout's anchor handler (the
      // .smark is a real #top link); this only owns the spring. The
      // animation restarts by class removal + a forced style flush —
      // getBoundingClientRect, not offsetWidth, because an SVG <g> has
      // no offsetWidth. animationend is filtered by name so the touch
      // idle spring (s-idle, same element) can never eat the class.
      const sTop = document.getElementById('sTop');
      const sMark = sTop && sTop.closest('.closing-mark');
      if (sMark) {
        // Live tunables, 2026-08-21. The light above the S and the size
        // of its wiggle are taste calls, so they ride the URL like the
        // rest of the beat: ?chev=sweep|relay|ghost, ?quiver= and ?buzz=
        // in degrees, ?chevrate= in seconds.
        const q = new URLSearchParams(location.search);
        const chev = q.get('chev');
        if (chev === 'sweep' || chev === 'relay' || chev === 'ghost') sMark.dataset.chev = chev;
        const tune = (key, prop, unit) => {
          const v = parseFloat(q.get(key));
          if (isFinite(v)) sMark.style.setProperty(prop, v + unit);
        };
        tune('quiver', '--s-quiver', 'deg');
        tune('buzz', '--s-buzz', 'deg');
        tune('chevrate', '--chev-rate', 's');

        // The pressed state is ALSO carried by a class. `:active` on a link
        // is unreliable on touch engines (iOS only honours it once something
        // is listening for touches), and on a phone the press is the whole
        // tell, so it cannot be left to chance. :is(:active, .is-tensed) in
        // scroll.css keeps the specificity identical to plain :active.
        const tense = (on) => sTop.classList.toggle('is-tensed', on);
        sTop.addEventListener('pointerdown', () => tense(true));
        // Press-and-hold is the tell, so the browser's hold gesture must not
        // answer over it (JJ, 2026-08-22, Chrome on the phone): no link sheet,
        // no drag of the anchor. CSS carries the iOS/selection half; this is
        // the half Android Chrome only honours as an event.
        sTop.addEventListener('contextmenu', (e) => e.preventDefault());
        sTop.addEventListener('dragstart', (e) => e.preventDefault());
        ['pointerup', 'pointercancel', 'pointerleave', 'blur'].forEach(
          (ev) => sTop.addEventListener(ev, () => tense(false))
        );

        const sGlyph = sMark.querySelector('.wm-s');
        if (sGlyph && !reduce) {
          sTop.addEventListener('click', () => {
            sGlyph.classList.remove('is-firing');
            sMark.classList.remove('is-firing');
            void sGlyph.getBoundingClientRect().width;
            sGlyph.classList.add('is-firing');
            // the chevrons leave upward on the same beat; the class sits
            // on the mark because .schev is not inside .wm-s
            sMark.classList.add('is-firing');
          });
          sGlyph.addEventListener('animationend', (e) => {
            if (e.animationName === 's-fire') {
              sGlyph.classList.remove('is-firing');
              sMark.classList.remove('is-firing');
            }
          });
        }
      }

      // (board 12 morph script removed with the 07b beat, 2026-08-17)
    })();
  </script>
</Scroll>
