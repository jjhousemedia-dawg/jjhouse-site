---
import Scroll from '../layouts/Scroll.astro';
import data from '../data/projects.json';
import Wordmark from '../components/Wordmark.astro';

// --- beat 05 selection -------------------------------------------------
// PLACEHOLDER PICK. Chosen to cover range and to include the two projects
// JJ has already named as anecdotes (Music is Better, The Districts).
// Swap these slugs when he confirms the real six.
const FEATURED = [
  'charli-xcx-used-to-know-me',
  'rufus-du-sol-music-is-better',
  'magdalena-bay-chaeri',
  'the-districts-outlaw-love',
  'finneas-cleats',
  'amiri-pacific-flat',
];

const bySlug = Object.fromEntries(data.projects.map((p) => [p.slug, p]));
const featured = FEATURED.map((s) => bySlug[s]).filter(Boolean);

// Little Dot gets its own beat. Figures are JJ's verified numbers.
const LDS = { channels: '15+', views: '5B+', subs: '5.1M' };

const sizes = ['project--l', 'project--r', 'project--xl', 'project--l', 'project--r', 'project--xl'];
---

<Scroll loader={true} title="JJ House — Creative Director" desc="JJ House. Creative director in Los Angeles.">
  <!-- ================= 01 ARRIVAL ================= -->
  <header class="beat arrival">
    <div class="arrival__top">
      <div>
        <!-- 01-A trimmed to the plain clause 2026-08-17 (JJ): the second
             clause ("the part I own…") read as operations/AI-speak. A
             sensibility-forward second clause may return; workshop it with
             JJ, never draft-and-ship. -->
        <p class="arrival__deck">
          I work with brands and artists on films and campaigns.
        </p>
        <!-- Board 2 + noth.in both carry a CTA in the hero. The only CTA on the
             page was 9,700px down, for a hiring-manager audience. -->
        <p class="arrival__cta">
          <a class="btn" href="#comein"><span>Book a call &rarr;</span></a>
        </p>
      </div>
      <button class="arrival__menu" id="menuBtn" data-menu-open aria-expanded="false">Menu ::</button>
    </div>

    <!-- Board 2. Surface minimal, substrate maximal. Drag to erode; it
         refills like foam closing over water. The canvas here is a 2D
         stand-in for the WebGL2 mask-reveal (decay ~0.94, stamp ~8vw,
         noise matched to hair scale). Substrate becomes Blender geo-nodes
         work, in colour, per spec §5. -->
    <!-- The ink layer spans the whole hero, NOT the wordmark box. That is the
         point of the reference: the letterforms are part of one sheet lying
         over the water, and the cursor shoves that sheet around, so torn ink
         has to be able to pile up well outside the letters. -->
    <canvas class="surface__erode" id="erode"></canvas>

    <div class="surface" id="surface">
      <div class="surface__substrate"></div>
      <div class="wordmark__svg"><Wordmark /></div>
    </div>

    <div class="arrival__foot">
      <span class="meta">Creative direction &middot; Los Angeles</span>
      <span class="meta">LinkedIn / <a href="https://www.instagram.com/jj.duplex/" style="color:inherit">Instagram</a> / Resume</span>
    </div>
  </header>

  <!-- 02 statement cut 2026-08-17 (JJ): "The work you deliver is never the
       work you pitched" removed entirely — his read was that it sat on its
       own island and didn't pull people down the page. What remains is his
       ask: about half a viewport of open paper for the hero's torn ink to
       run into (the erode canvas reaches past the hero on purpose) before
       the page hits the reel. -->
  <section class="beat beat--breather" aria-hidden="true"></section>

  <!-- 03 ASIDE cut 2026-08-17 (JJ): the (premise) paragraphs read as
       pessimistic rumination to a cold viewer. Text lives in git history;
       any return goes through JJ's rewrite, not a paste-back. -->

  <!-- ================= 04 REEL — the flip point ================= -->
  <section class="reel" id="reel">
    <div class="reel__sticky">
      <!-- Board 9. The pink drawing on JJ's board is the environment the
           video sits inside. Grid below stands in for that room until the
           Blender plate exists. Spec §9: biggest single asset, still TBD. -->
      <div class="reel__room" aria-hidden="true"></div>

      <button class="reel__sound" id="soundBtn" aria-pressed="false"><span>Sound</span></button>

      <!-- data-beauty / data-reflect: set these to the water-room plate URLs
           when they exist and the scrub rig below takes over automatically. -->
      <div class="reel__frame" id="reelFrame" data-beauty="" data-reflect="">
        <div class="ph" style="width:min(90%,60rem);aspect-ratio:16/9">
          REEL &mdash; beauty plate
          <small>enters full bleed, recedes with perspective as you scroll</small>
          <small>board 4: returns to full size on scroll up</small>
        </div>
        <!-- Board 9 + verified on noth.in: CLEAN.mp4 stacked directly above
             REFLECT.mp4, exactly one video height apart. Separate pass, not
             a CSS trick, once the Blender render exists. -->
        <div class="ph reel__reflect" style="width:min(90%,60rem);aspect-ratio:16/5" aria-hidden="true">
          reflection pass
        </div>
      </div>

      <!-- 04-A: a line sits here beside the reel, without any house wordplay
           (ruled 2026-08-11). JJ's words to come — no visible placeholder in
           the meantime (dev notes stripped from previews 2026-08-17). -->
    </div>
  </section>

  <!-- ================= 05 WORK ================= -->
  <section class="beat" id="work">
    <!-- Board 5, verified live on noth.in: the word is whole and large at
         entry, its letters scatter across the header mid-section, then it
         splits W | ORKS and reassembles small. Scroll-driven, not timed. -->
    <div class="worksmark" aria-hidden="true">
      <div class="worksmark__row" id="worksRow">
        <span class="worksmark__l">W</span><span class="worksmark__l">O</span><span
          class="worksmark__l">R</span><span class="worksmark__l">K</span><span
          class="worksmark__l">S</span>
      </div>
    </div>

    <div class="ticker">
      <span class="ticker__slot" id="tickerSlot">WORKS</span>
      <button class="ticker__slot ticker__menu" data-menu-open aria-expanded="false">MENU ::</button>
    </div>

    <div class="beat__inner">
      <div class="projects">
        {featured.map((p, i) => (
          <article class={`project ${sizes[i % sizes.length]}`} data-rise data-roles={p.roles.join('|')}>
            <a class="project__link" href={`/work/${p.slug}`}>
              <div class="project__media">
                <img
                  src={`/thumbs/${p.slug}.webp`}
                  alt={`${p.title} — still`}
                  width="1280" height="720"
                  loading={i < 2 ? 'eager' : 'lazy'}
                  decoding="async"
                />
              </div>
              <h2 class="project__title">{p.title}</h2>
              <span class="project__go">Open project &#8627;</span>
            </a>
            <div class="project__roles">
              {p.roles.map((r) => <span class="meta">{r}</span>)}
            </div>
            {p.anecdote && <p class="project__note">{p.anecdote}</p>}
          </article>
        ))}
      </div>

      <p class="viewall" data-rise><a href="/work">View all &#8627;</a></p>
    </div>
  </section>

  <!-- ================= 06 LITTLE DOT ================= -->
  <section class="beat">
    <!-- Little Dot framing still open (06-C). JJ's direction 2026-08-17:
         straightforward over blanket-summary — likely its own works-style
         story built from a few specific things he makes there, plus visuals
         and maybe links. Label "( the other half )" cut per JJ. -->
    <div class="beat__inner" data-rise>
      <h2 class="statement">Not everything I make is a film.</h2>
      <div class="prose" style="margin-top:2.5rem">
        <p>
          {LDS.channels} brand and creator channels. {LDS.views} views and {LDS.subs} subscribers
          across the tenure. Love Island packaging, Pokemon, originals programmed and written and
          thumbnailed.
        </p>
      </div>
    </div>
  </section>

  <!-- ================= 07 HOW I WORK ================= -->
  <section class="beat" id="how">
    <div class="beat__inner" data-rise>
      <p class="label">( how I work )</p>
      <!-- Trimmed 2026-08-17 (JJ): "All that range…" cut outright; the
           authentic/unique critique may find a home on the site someday but
           wasn't linking to how-I-work. Beat needs a real rewrite with JJ. -->
      <div class="principles">
        <p class="principle">
          I prefer, &ldquo;How do we position and frame this so it becomes what it&rsquo;s trying to
          be?&rdquo;
        </p>
      </div>

      <!-- Board 11's skills list was wired here; JJ ruled it out 2026-08-11.
           The prose carries the argument alone. -->
    </div>
  </section>

  <!-- 07b MORPH and 08 NOW cut 2026-08-17 (JJ) per the 8/14 ship plan:
       both were pure wireframe with no written copy. Markup in git history. -->

  <!-- ================= 09 COME IN ================= -->
  <footer class="beat" id="comein">
    <div class="beat__inner" data-rise>
      <p class="label">( come in )</p>
      <!-- "Tell me what you can already see." cut 2026-08-17 (JJ): not
           saying anything, causing confusion. Closing line TBD with JJ. -->
      <div class="cta">
        <a class="btn" href="mailto:jj@jjhouse.me"><span>Email me @</span></a>
        <!-- interim destination — JJ is picking a booking tool (likely a Google
             Workspace appointment schedule). Swap this href when he does. -->
        <a class="btn" href="mailto:jj@jjhouse.me?subject=Call"><span>Book a call &rarr;</span></a>
      </div>
      <div class="closing-mark"><Wordmark /></div>
    </div>
    <div class="colophon">
      <span class="meta">&copy; 2026 JJ House &middot; Los Angeles</span>
      <span class="meta">
        <a href="https://www.imdb.com/name/nm7420692/" style="color:inherit">IMDb</a> /
        <a href="https://www.instagram.com/jj.duplex/" style="color:inherit">Instagram</a>
      </span>
    </div>
  </footer>

  <script>
    // WebGL2 wordmark erosion. If it cannot start (no WebGL2, reduced
    // motion, shader failure) the DOM text simply stays visible and
    // nothing else on the page changes.
    import { initErode } from '../scripts/erode.js';
    const surface = document.getElementById('surface');
    if (surface) {
      let ok = false;
      try { ok = initErode(surface); } catch (err) { console.error('[erode]', err); }
      if (ok) surface.classList.add('is-canvas');
    }
  </script>

  <script is:inline>
    (function () {
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // ---- the flip point. Ruled by JJ 2026-08-17: strictly positional. ----
      // Above the reel's midpoint = always light, below = always dark, no
      // one-way latch. Evaluated on load, scroll, resize, and pageshow so a
      // refresh mid-page or a back/forward return can never strand the page
      // in the wrong mode (the old one-way IntersectionObserver did exactly
      // that when scroll restoration landed past the reel).
      const reel = document.getElementById('reel');
      if (reel) {
        const setTheme = () => {
          const r = reel.getBoundingClientRect();
          const dark = r.top + r.height / 2 <= window.innerHeight / 2;
          document.body.classList.toggle('is-dark', dark);
        };
        addEventListener('scroll', setTheme, { passive: true });
        addEventListener('resize', setTheme);
        addEventListener('pageshow', setTheme);
        setTheme();
      }

      // ---- the reel recedes as you scroll through it ----
      const frame = document.getElementById('reelFrame');
      if (frame && reel && !reduce) {
        const onScroll = () => {
          const r = reel.getBoundingClientRect();
          const total = r.height - window.innerHeight;
          if (total <= 0) return;
          const p = Math.min(1, Math.max(0, -r.top / total));
          frame.style.setProperty('--recede', String(1 - p * 0.45));
        };
        addEventListener('scroll', onScroll, { passive: true });
        onScroll();
      }

      // ---- the credit ticker: CUT 2026-08-17 (JJ). ----
      // The per-project role cycling ("the flashing between Produce, VFX +
      // Edit") wasn't working for him. The slot now just says WORKS. Do not
      // resurrect the flicker; the roles already sit on each card.

      // ---- board 5: the WORKS letters migrate ----------------------
      // Whole and large on entry, scattered across the header at the
      // midpoint, split W | ORKS and small on exit. Driven by scroll
      // position through the work section, so it reverses on scroll up.
      const row = document.getElementById('worksRow');
      const workSec = document.getElementById('work');
      if (row && workSec && !reduce) {
        const letters = [...row.querySelectorAll('.worksmark__l')];
        const n = letters.length;
        const lerp = (a, b, f) => a + (b - a) * f;
        const ease = (x) => (x < 0.5 ? 2 * x * x : 1 - Math.pow(-2 * x + 2, 2) / 2);

        const place = () => {
          const r = workSec.getBoundingClientRect();
          const span = r.height - window.innerHeight;
          if (span <= 0) return;
          const p = Math.min(1, Math.max(0, -r.top / span));
          const W = row.clientWidth || 1;

          letters.forEach((el, i) => {
            const bigPx = 104, smallPx = 26;   // watermark scale, behind content
            // three keyframes: clustered left, scattered, split
            const startX = i * bigPx * 0.78;
            const midX = (i / (n - 1)) * (W - smallPx * 2);
            const endX = i === 0 ? 0 : W - (n - i) * smallPx * 0.95 - 4;

            let x, fs;
            if (p < 0.5) {
              const f = ease(p / 0.5);
              x = lerp(startX, midX, f);
              fs = lerp(bigPx, smallPx + 4, f);
            } else {
              const f = ease((p - 0.5) / 0.5);
              x = lerp(midX, endX, f);
              fs = lerp(smallPx + 4, smallPx, f);
            }
            el.style.transform = `translateX(${x}px)`;
            el.style.fontSize = fs + 'px';
            // ghost register: present, never competing with the words on top
            el.style.opacity = String(0.10 + 0.10 * (1 - Math.abs(0.5 - p) * 2));
          });
        };
        addEventListener('scroll', place, { passive: true });
        addEventListener('resize', place);
        place();
      }

      // ---- board 9: sound toggle, off by default -------------------
      const sound = document.getElementById('soundBtn');
      if (sound) {
        sound.addEventListener('click', () => {
          const on = sound.getAttribute('aria-pressed') === 'true';
          sound.setAttribute('aria-pressed', String(!on));
        });
      }

      // ---- reel scrub rig — noth.in's actual gallery mechanic --------
      // Two pre-rendered plates, scroll-scrubbed. Inert until data-beauty
      // is set (the water-room renders). fastSeek where available.
      const rig = document.getElementById('reelFrame');
      const srcB = rig && rig.dataset.beauty;
      if (rig && srcB && reel && !reduce) {
        const mk = (src, cls) => {
          const v = document.createElement('video');
          v.src = src; v.muted = true; v.playsInline = true;
          v.preload = 'auto'; v.className = cls;
          return v;
        };
        const vb = mk(srcB, 'reel__video');
        const vr = rig.dataset.reflect ? mk(rig.dataset.reflect, 'reel__video reel__video--reflect') : null;
        rig.innerHTML = '';
        rig.appendChild(vb);
        if (vr) rig.appendChild(vr);
        const scrub = () => {
          const r = reel.getBoundingClientRect();
          const total = r.height - window.innerHeight;
          if (total <= 0 || !vb.duration) return;
          const p = Math.min(1, Math.max(0, -r.top / total));
          const t = p * vb.duration * 0.999;
          if (vb.fastSeek) vb.fastSeek(t); else vb.currentTime = t;
          if (vr && vr.duration) vr.currentTime = Math.min(t, vr.duration * 0.999);
        };
        addEventListener('scroll', scrub, { passive: true });
        vb.addEventListener('loadedmetadata', scrub);
      }

      // (board 12 morph script removed with the 07b beat, 2026-08-17)
    })();
  </script>
</Scroll>
