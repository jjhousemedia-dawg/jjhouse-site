---
import Scroll from '../layouts/Scroll.astro';
import data from '../data/projects.json';

const url = (v) =>
  v.type === 'youtube' ? `https://www.youtube.com/watch?v=${v.id}` : `https://vimeo.com/${v.id}`;

const work = data.projects.filter((p) => p.category === 'work');
const personal = data.projects.filter((p) => p.category === 'personal');

const groups = [
  { label: '( the work )', items: work },
  { label: '( for the love of it )', items: personal },
];
---

<Scroll title="Work — JJ House" desc="Everything. 45 projects across directing, producing, VFX and edit." dark={true}>
  <main class="archive">
    <p class="label" style="padding-top:2rem">
      <a href="/" style="color:inherit;text-decoration:none">&#8624; back</a>
    </p>

    <h1 class="statement" style="max-width:14ch">Everything.</h1>
    <p class="prose" style="margin-top:2rem;opacity:0.65">
      {data.projects.length} projects. The front page is the curated version; this is the whole list.
    </p>

    {groups.map((g) => g.items.length > 0 && (
      <section style="margin-top:clamp(4rem,10vh,7rem)">
        <p class="label">{g.label}</p>
        <div class="archive__list">
          {g.items.map((p, i) => (
            <a class="archive__row" href={url(p.video)} target="_blank" rel="noopener">
              <span class="archive__n">{String(i + 1).padStart(2, '0')}</span>
              <span class="archive__t">{p.title}</span>
              <span class="archive__r">{p.roles.length ? p.roles.join(' · ') : p.video.type}</span>
            </a>
          ))}
        </div>
      </section>
    ))}

    <p class="prose meta" style="display:block;margin-block:4rem 6rem;opacity:0.45">
      Older gallery, kept as-is:
      <a href="https://www.jjhouse.me" style="color:inherit" target="_blank" rel="noopener">jjhouse.me</a>
    </p>
  </main>
</Scroll>
