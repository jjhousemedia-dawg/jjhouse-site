---
import Scroll from '../layouts/Scroll.astro';
import data from '../data/projects.json';

// Video-less projects (video: null — e.g. Field Journal until its hero
// videos come off JJ's external drive) link to their own /work/ page
// instead of out to a player.
const url = (p) =>
  !p.video ? `/work/${p.slug}`
  : p.video.type === 'youtube' ? `https://www.youtube.com/watch?v=${p.video.id}`
  : `https://vimeo.com/${p.video.id}`;

const work = data.projects.filter((p) => p.category === 'work');
const personal = data.projects.filter((p) => p.category === 'personal');

const groups = [
  { label: '( the work )', items: work },
  { label: '( for the love of it )', items: personal },
];
---

<Scroll title="Work — JJ House" desc={`Everything. ${data.projects.length} projects across directing, producing, VFX and edit.`} dark={true}>
  <main class="archive">
    <p class="label" style="padding-top:2rem">
      <a href="/" style="color:inherit;text-decoration:none">&#8624; back</a>
    </p>

    <h1 class="statement" style="max-width:14ch">Everything.</h1>
    <p class="prose" style="margin-top:2rem;opacity:0.65">
      {data.projects.length} projects. The front page is the curated version; this is the whole list.
    </p>

    {groups.map((g) => g.items.length > 0 && (
      <section style="margin-top:clamp(4rem,10vh,7rem)">
        <p class="label">{g.label}</p>
        <div class="archive__list">
          {g.items.map((p, i) => (
            <a class="archive__row" href={url(p)} target={p.video ? '_blank' : undefined} rel={p.video ? 'noopener' : undefined} data-thumb={p.video ? `/thumbs/${p.slug}.webp` : undefined}>
              <span class="archive__n">{String(i + 1).padStart(2, '0')}</span>
              <span class="archive__t">{p.title}</span>
              <span class="archive__r">{p.roles.length ? p.roles.join(' · ') : (p.video?.type ?? '')}</span>
            </a>
          ))}
        </div>
      </section>
    ))}

    <p class="prose meta" style="display:block;margin-block:4rem 6rem;opacity:0.45">
      Older gallery, kept as-is:
      <a href="https://www.jjhouse.me" style="color:inherit" target="_blank" rel="noopener">jjhouse.me</a>
    </p>
    <img class="archive__peek" id="peek" alt="" width="1280" height="720" hidden />
  </main>

  <script is:inline>
    // Hover peek: the row under the cursor shows its still, trailing the
    // pointer with a little inertia. Colour is allowed — it is the work.
    (function () {
      const peek = document.getElementById('peek');
      if (!peek) return;
      if (matchMedia('(hover: none)').matches ||
          matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      let x = 0, y = 0, tx = 0, ty = 0, on = false, raf = null;
      const place = (e) => {
        const w = peek.offsetWidth || 320, h = peek.offsetHeight || 180;
        tx = Math.min(e.clientX + 28, innerWidth - w - 16);
        ty = Math.min(Math.max(e.clientY - h / 2, 12), innerHeight - h - 12);
      };
      const loop = () => {
        x += (tx - x) * 0.16; y += (ty - y) * 0.16;
        peek.style.transform = `translate(${x}px, ${y}px)`;
        if (on) raf = requestAnimationFrame(loop);
      };
      document.querySelectorAll('.archive__row[data-thumb]').forEach((row) => {
        row.addEventListener('pointerenter', (e) => {
          peek.src = row.dataset.thumb;
          peek.hidden = false; on = true;
          place(e); x = tx; y = ty;
          peek.classList.add('on');
          cancelAnimationFrame(raf); raf = requestAnimationFrame(loop);
        });
        row.addEventListener('pointermove', place);
        row.addEventListener('pointerleave', () => {
          peek.classList.remove('on'); on = false;
          setTimeout(() => { if (!on) peek.hidden = true; }, 220);
        });
      });
    })();
  </script>
</Scroll>
