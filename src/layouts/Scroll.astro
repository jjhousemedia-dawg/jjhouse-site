---
import '../styles/scroll.css';
import Wordmark from '../components/Wordmark.astro';

const {
  title = 'JJ House',
  desc = 'JJ House. Creative director in Los Angeles.',
  dark = false,
  loader = false,
  noindex = false,
} = Astro.props;

// Board 1 + spec §5. Dead centre, never captioned and never explained.
// Egg is always first; the rest cycle freely because absorption is felt
// rather than literal.
//
// The duck is load-bearing, not a whim: a decoy is an object built to be
// believed, and a duck on water is a composed surface with everything
// happening underneath — which is the hero mechanic. Keystone is
// Pennsylvania, an IYKYK.
//
// 2026-08-22: these were hand-authored SVG silhouettes and are now rendered
// stills, shot from the real models in `Site-Loading-Icons_v1.blend`. Each
// object is lit its own way — a north-window key on the egg, a raking key
// on the decoy so the carving reads, two separately-lit planes on the
// keystone, uplight on the saucer, a broad softbox for the wedge's face —
// then comped to black and white with a little bloom and grain. 512px WebP,
// straight alpha, ~12KB each and 60KB for the set.
//
// ⚠ This supersedes the "flat matte silhouettes, never reads as 3D" line
// in docs/SITE-SPEC.md §5. The spec has not been updated; JJ's call.
const OBJECTS = [
  { k: 'egg',      src: '/loader/egg.webp' },
  { k: 'decoy',    src: '/loader/decoy.webp' },
  { k: 'keystone', src: '/loader/keystone.webp' },
  // JJ cut the tuning fork (2026-08-11) and floated a UFO — which fits the
  // set's own logic better than the fork did: the loader is literally a
  // cycle of unexplained objects, and this is the canonical one. The dome
  // and collar were remodelled so it carries the same visual mass as the
  // other four rather than reading as a thin disc.
  { k: 'ufo',      src: '/loader/ufo.webp' },
  { k: 'iron',     src: '/loader/iron.webp' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:site_name" content="JJ House" />
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL('/og.png', Astro.site)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      // PHONE, 2026-08-22 (JJ): reloading the front page part-way down came
      // back part-way down — and because the loader curtain hides the page
      // while it counts, the curtain lifted onto the middle of the scroll,
      // hero and Connect never seen. The front page is one narrative that
      // starts at the top, so it opens at the top; the browser's silent
      // scroll restore is refused only here, and only when the URL is not
      // pointing at something (a real #work / #comein link still wins).
      // pageshow rather than load: it fires AFTER the restore, and
      // e.persisted lets a back-button return keep its place.
      (function () {
        var front = location.pathname === '/' || location.pathname === '/index.html';
        if (!front) return;
        if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
        addEventListener('pageshow', function (e) {
          if (!e.persisted && !location.hash) window.scrollTo(0, 0);
        });
      })();
    </script>
    {loader && <link rel="preload" as="image" href="/loader/egg.webp" type="image/webp" />}
    <meta name="theme-color" content="#0a0908" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300&family=Inter:wght@400;500&family=IBM+Plex+Mono&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class:list={['scroll', dark && 'is-dark']}>
    {loader && (
      <div id="loader" role="presentation">
        <div class="loader__stage">
          <div class="loader__objects" id="loaderObjs">
            {OBJECTS.map((o, i) => (
              <div class={`loader__obj${i === 0 ? ' on' : ''}`} data-obj={o.k}>
                <img
                  src={o.src}
                  width="512"
                  height="512"
                  alt=""
                  aria-hidden="true"
                  decoding="async"
                  fetchpriority={i === 0 ? 'high' : 'auto'}
                />
              </div>
            ))}
          </div>
          <div class="loader__mark" id="loaderMark"><Wordmark hidden={true} /></div>
        </div>
        <p class="loader__pct" id="loaderPct">000</p>
      </div>
    )}

    <slot />

    <!-- Menu survives the whole page — ruled by JJ 2026-08-17: the option
         must never disappear and come back, especially at the bottom. One
         fixed trigger in the layout (every page gets it, including /work
         and project pages, which previously had NO trigger at all); the
         hero's inline button and the ticker's MENU slot were retired so the
         corner never doubles up. mix-blend difference keeps it legible
         across the light/dark flip. -->
    <button class="menu-fab" data-menu-open aria-expanded="false">Menu ::</button>

    <!-- ---- the menu. One overlay for every page; opened by any
         [data-menu-open] trigger. Always ink on paper-text regardless of
         the flip. ---- -->
    <div id="menu" class="menu" hidden>
      <button class="menu__close" id="menuClose" aria-label="Close menu">Close ::</button>
      <nav class="menu__nav" aria-label="Site">
        <a class="menu__link" href="/#work">Featured work</a>
        <a class="menu__link" href="/work">Everything &#8627;</a>
        <a class="menu__link" href="/#how">How I work</a>
        <a class="menu__link" href="/#comein">Connect</a>
      </nav>
      <div class="menu__meta">
        <a href="mailto:jj@jjhouse.me">jj@jjhouse.me</a>
        <a href="https://www.linkedin.com/in/jjhousemedia/" target="_blank" rel="noopener">LinkedIn</a>
        <a href="https://www.imdb.com/name/nm7420692/" target="_blank" rel="noopener">IMDb</a>
        <a href="https://www.instagram.com/jj.duplex/" target="_blank" rel="noopener">Instagram</a>
        <a href="/JJ-House-Resume-2026.pdf" target="_blank">Resume</a>
      </div>
    </div>

    <script>
      // ---- Lenis. Verified running on noth.in; every scroll-scrubbed
      // mechanic in the spec needs a per-frame virtual scroll position,
      // which native CSS smooth scrolling does not provide. ----
      import Lenis from 'lenis';

      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (!reduce) {
        const lenis = new Lenis({
          duration: 1.05,
          easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
          smoothWheel: true,
          touchMultiplier: 1.6,
        });
        window.__lenis = lenis;
        const raf = (time) => { lenis.raf(time); requestAnimationFrame(raf); };
        requestAnimationFrame(raf);

        // Lenis intercepts the wheel but not anchor clicks. Since we had to
        // drop scroll-behavior:smooth for it, every in-page link would jump
        // instantly and leave Lenis's internal position desynced from the
        // real one, which breaks every scrubbed mechanic until the next wheel
        // event. Route anchors through Lenis instead.
        // Anchor jumps, ruled by JJ 2026-08-17: a tape fast-forward, not a
        // hard cut — TLDR skippers still glimpse the journey. Duration
        // scales with distance (short hops stay quick, the full-page dive
        // takes ~2.5s), and the easing is in-out: it leaves gently,
        // accelerates through the middle, and comes to a nice halt. (The
        // Lenis instance default is ease-out — max speed at frame one —
        // which is exactly the jumpiness JJ flagged.)
        const anchorOpts = (target) => {
          const dist = Math.abs(target.getBoundingClientRect().top);
          return {
            duration: Math.min(2.6, 1.2 + (dist / window.innerHeight) * 0.12),
            easing: (t) => (t < 0.5 ? 8 * t * t * t * t : 1 - Math.pow(-2 * t + 2, 4) / 2),
          };
        };
        window.__anchorOpts = anchorOpts;
        document.addEventListener('click', (e) => {
          const a = e.target.closest('a[href^="#"]');
          if (!a) return;
          const id = a.getAttribute('href');
          if (!id || id === '#') return;
          const target = document.querySelector(id);
          if (!target) return;
          e.preventDefault();
          lenis.scrollTo(target, { offset: 0, ...anchorOpts(target) });
          history.replaceState(null, '', id);
        });
      }
    </script>

    <script is:inline>
      // Reveal on scroll. Everything starts hidden only if JS is running,
      // so a no-JS reader still gets the whole page.
      (function () {
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const items = document.querySelectorAll('[data-rise]');
        items.forEach((el) => el.classList.add('rise'));
        if (reduce) {
          items.forEach((el) => el.classList.add('in'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('in');
                io.unobserve(e.target);
              }
            });
          },
          { rootMargin: '0px 0px -12% 0px', threshold: 0.1 }
        );
        items.forEach((el) => io.observe(el));
      })();
    </script>

    <!-- The wordmark fit-to-measure script lived here. Gone on purpose:
         the mark ships as SVG outlines (src/components/Wordmark.astro) at
         width:100%, which is exact at every viewport with no measurement,
         the same way noth.in does it. /type-test keeps the live-text bench
         for any future face ruling. -->

    <script is:inline>
      // ---- the menu -------------------------------------------------
      (function () {
        const menu = document.getElementById('menu');
        if (!menu) return;
        const triggers = [...document.querySelectorAll('[data-menu-open]')];
        const closeBtn = document.getElementById('menuClose');
        let lastFocus = null;

        const open = () => {
          lastFocus = document.activeElement;
          menu.hidden = false;
          requestAnimationFrame(() => menu.classList.add('on'));
          triggers.forEach((t) => t.setAttribute('aria-expanded', 'true'));
          document.documentElement.classList.add('menu-open');
          if (window.__lenis) window.__lenis.stop();
          const first = menu.querySelector('a');
          if (first) first.focus();
        };
        const close = () => {
          menu.classList.remove('on');
          triggers.forEach((t) => t.setAttribute('aria-expanded', 'false'));
          document.documentElement.classList.remove('menu-open');
          if (window.__lenis) window.__lenis.start();
          setTimeout(() => { menu.hidden = true; }, 380);
          if (lastFocus && lastFocus.focus) lastFocus.focus();
        };

        triggers.forEach((t) => {
          t.setAttribute('aria-haspopup', 'true');
          t.setAttribute('aria-controls', 'menu');
          t.addEventListener('click', open);
        });
        closeBtn.addEventListener('click', close);
        addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && !menu.hidden) close();
        });
        // in-page links: close, then let Lenis carry the scroll on the
        // homepage; on other pages they are ordinary navigations
        menu.addEventListener('click', (e) => {
          const a = e.target.closest('a');
          if (!a) return;
          const href = a.getAttribute('href') || '';
          if (href.startsWith('/#') && location.pathname === '/') {
            e.preventDefault();
            close();
            const target = document.querySelector(href.slice(1));
            if (target) {
              if (window.__lenis) {
                const opts = window.__anchorOpts ? window.__anchorOpts(target) : { duration: 1.2 };
                window.__lenis.scrollTo(target, opts);
              }
              else target.scrollIntoView();
              history.replaceState(null, '', href.slice(1));
            }
          } else {
            close();
          }
        });
      })();
    </script>

    <script is:inline>
      // ---- 00 loader — board 1 + spec §5 ------------------------------
      // Rapid cycle of unexplained objects, egg always first, remainder in a
      // free order because absorption is felt rather than literal. Each swap
      // is preceded by a one-beat shudder, which is the anticipation frame
      // that makes the object appear to decide. Resolves to the mark.
      (function () {
        const el = document.getElementById('loader');
        if (!el) return;
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        const objsWrap = document.getElementById('loaderObjs');
        const objs = objsWrap ? [...objsWrap.querySelectorAll('.loader__obj')] : [];
        const mark = document.getElementById('loaderMark');
        const pct = document.getElementById('loaderPct');

        const lift = () => {
          el.classList.add('done');
          document.documentElement.removeAttribute('data-loading');
          // The curtain must never lift onto the middle of the page. The head
          // script has already refused the browser's restore; this is the
          // belt to that suspenders, and it also re-seats Lenis, whose own
          // position would otherwise still hold whatever it was handed.
          if (!location.hash) {
            window.scrollTo(0, 0);
            if (window.__lenis) window.__lenis.scrollTo(0, { immediate: true, force: true });
          }
          if (window.__lenis) window.__lenis.start();
        };

        if (reduce || !objs.length) { lift(); return; }

        document.documentElement.setAttribute('data-loading', '');
        if (window.__lenis) window.__lenis.stop();

        // egg first, the rest shuffled
        const rest = objs.slice(1);
        for (let i = rest.length - 1; i > 0; i--) {
          const j = Math.floor(Math.random() * (i + 1));
          [rest[i], rest[j]] = [rest[j], rest[i]];
        }
        // 9 beats over the cycle, so objects repeat — the set reads as a
        // rhythm rather than as a list being enumerated
        const seq = [objs[0]];
        for (let i = 0; i < 8; i++) seq.push(rest[i % rest.length]);

        const TOTAL = 2200;
        const t0 = performance.now();
        let step = -1, finished = false;

        const show = (i) => {
          objs.forEach((o) => o.classList.remove('on'));
          if (seq[i]) seq[i].classList.add('on');
          objsWrap.classList.remove('shudder');
          void objsWrap.offsetWidth;          // restart the animation
          objsWrap.classList.add('shudder');
        };

        const finish = () => {
          if (finished) return;
          finished = true;
          objs.forEach((o) => o.classList.remove('on'));
          if (pct) pct.textContent = '100';
          if (mark) mark.classList.add('on');
          setTimeout(lift, 620);
        };

        // Backstop: rAF does not fire in a background tab, so a loader driven
        // only by rAF strands the curtain if the site opens in one.
        const hardStop = setTimeout(finish, TOTAL + 1400);
        document.addEventListener('visibilitychange', () => {
          if (document.visibilityState === 'visible' &&
              performance.now() - t0 >= TOTAL) finish();
        });

        const tick = (now) => {
          if (finished) return;
          const p = Math.min(1, (now - t0) / TOTAL);
          if (pct) pct.textContent = String(Math.round(p * 100)).padStart(3, '0');
          // accelerate: the cycle tightens as it converges on the mark
          const eased = Math.pow(p, 0.72);
          const want = Math.min(seq.length - 1, Math.floor(eased * seq.length));
          if (want !== step) { step = want; show(want); }
          if (p < 1) requestAnimationFrame(tick);
          else { clearTimeout(hardStop); finish(); }
        };
        requestAnimationFrame(tick);
      })();
    </script>
  </body>
</html>
