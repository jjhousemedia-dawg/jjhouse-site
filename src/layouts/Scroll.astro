---
import '../styles/scroll.css';

const {
  title = 'JJ House',
  desc = 'JJ House. Creative strategist in Los Angeles.',
  dark = false,
  loader = false,
} = Astro.props;

// Board 1 + spec §5. Flat matte silhouettes, dead centre, never captioned
// and never explained. Egg is always first; the rest cycle freely because
// absorption is felt rather than literal.
//
// The duck is load-bearing, not a whim: a decoy is an object built to be
// believed, and a duck on water is a composed surface with everything
// happening underneath — which is the hero mechanic. Keystone is
// Pennsylvania, an IYKYK.
const OBJECTS = [
  {
    k: 'egg',
    svg: `<path d="M50 8c11 0 21 18 21 37 0 21-9 38-21 38S29 66 29 45C29 26 39 8 50 8z"/>`,
  },
  {
    k: 'decoy',
    svg: `<ellipse cx="46" cy="62" rx="31" ry="16"/>
          <path d="M62 46c0-7 5-13 12-13s12 6 12 13c0 5-3 10-8 12l-4 8-9-4 3-7c-3-2-6-5-6-9z"/>
          <path d="M84 40l12 3-12 5z"/>
          <path d="M15 56l-13-8 4 14z"/>`,
  },
  {
    k: 'keystone',
    svg: `<path d="M24 22h52l-9 56H33z"/>`,
  },
  {
    k: 'fork',
    svg: `<path d="M35 10h7v40h7V10h7v40h7v6c0 7-4 12-10 14v22h-8V70c-6-2-10-7-10-14z"/>`,
  },
  {
    k: 'iron',
    svg: `<path d="M63 6l7 2-19 58-7-2z"/>
          <path d="M22 64h40c5 0 9 4 9 9v8c0 5-4 9-9 9H30c-6 0-11-5-11-11z"/>`,
  },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={desc} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#0b0b0b" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;1,9..144,300&family=Zalando+Sans+Expanded:wght@400;700;900&family=Inter:wght@400;500&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class:list={['scroll', dark && 'is-dark']}>
    {loader && (
      <div id="loader" role="presentation">
        <div class="loader__stage">
          <div class="loader__objects" id="loaderObjs">
            {OBJECTS.map((o, i) => (
              <div class={`loader__obj${i === 0 ? ' on' : ''}`} data-obj={o.k}>
                <svg viewBox="0 0 100 100" aria-hidden="true" set:html={o.svg} />
              </div>
            ))}
          </div>
          <p class="loader__mark" id="loaderMark">HOUSE</p>
        </div>
        <p class="loader__pct" id="loaderPct">000</p>
      </div>
    )}

    <slot />

    <script>
      // ---- Lenis. Verified running on noth.in; every scroll-scrubbed
      // mechanic in the spec needs a per-frame virtual scroll position,
      // which native CSS smooth scrolling does not provide. ----
      import Lenis from 'lenis';

      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (!reduce) {
        const lenis = new Lenis({
          duration: 1.05,
          easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
          smoothWheel: true,
          touchMultiplier: 1.6,
        });
        window.__lenis = lenis;
        const raf = (time) => { lenis.raf(time); requestAnimationFrame(raf); };
        requestAnimationFrame(raf);

        // Lenis intercepts the wheel but not anchor clicks. Since we had to
        // drop scroll-behavior:smooth for it, every in-page link would jump
        // instantly and leave Lenis's internal position desynced from the
        // real one, which breaks every scrubbed mechanic until the next wheel
        // event. Route anchors through Lenis instead.
        document.addEventListener('click', (e) => {
          const a = e.target.closest('a[href^="#"]');
          if (!a) return;
          const id = a.getAttribute('href');
          if (!id || id === '#') return;
          const target = document.querySelector(id);
          if (!target) return;
          e.preventDefault();
          lenis.scrollTo(target, { offset: 0, duration: 1.2 });
          history.replaceState(null, '', id);
        });
      }
    </script>

    <script is:inline>
      // Reveal on scroll. Everything starts hidden only if JS is running,
      // so a no-JS reader still gets the whole page.
      (function () {
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const items = document.querySelectorAll('[data-rise]');
        items.forEach((el) => el.classList.add('rise'));
        if (reduce) {
          items.forEach((el) => el.classList.add('in'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('in');
                io.unobserve(e.target);
              }
            });
          },
          { rootMargin: '0px 0px -12% 0px', threshold: 0.1 }
        );
        items.forEach((el) => io.observe(el));
      })();
    </script>

    <script is:inline>
      // ---- the wordmark fills the measure, whatever face is loaded ----
      // noth.in solves this by shipping the wordmark as SVG outlines at
      // width:100%, which is exact at every viewport with no font metrics
      // involved. Until we outline ours, measure the actual advance width
      // of the word at a known size and scale to fit. Font-agnostic, so
      // swapping --font-wordmark needs no other change.
      (function () {
        const el = document.querySelector('.wordmark__placeholder');
        if (!el) return;
        const parent = el.parentElement;
        const hero = el.closest('.arrival');

        const fit = () => {
          // Measure the hero's content box, never a child. A child's width
          // can be inflated by the very nowrap text being sized, which
          // reads as "it fits" while the mark overflows the viewport.
          let measure;
          if (hero) {
            const hs = getComputedStyle(hero);
            measure = hero.clientWidth -
              (parseFloat(hs.paddingLeft) || 0) - (parseFloat(hs.paddingRight) || 0);
          } else {
            measure = parent.getBoundingClientRect().width;
          }
          if (!measure || measure < 40) return;
          const prev = el.style.fontSize;
          el.style.fontSize = '100px';
          const em = el.getBoundingClientRect().width / 100;
          el.style.fontSize = prev;
          // the measured advance already includes letter-spacing, so no
          // separate tracking term is needed here
          if (!em || !isFinite(em) || em < 0.5) return;

          // Width is only half the constraint. Filling the measure can make
          // the word taller than the row it lives in, which pushes it into
          // the footer. Cap by the available height too and take the smaller.
          const byWidth = measure / em;

          // The height budget must NOT be read from an ancestor whose height
          // is itself defined by this text — that is a feedback loop which
          // shrinks the type a few percent on every pass. Derive it from the
          // hero minus the fixed blocks above and below instead.
          let avail;
          if (hero) {
            const top  = hero.querySelector('.arrival__top');
            const foot = hero.querySelector('.arrival__foot');
            const pad  = parseFloat(getComputedStyle(hero).paddingTop) || 0;
            avail = hero.clientHeight - (top ? top.offsetHeight : 0) -
                    (foot ? foot.offsetHeight : 0) - pad * 2 - 36;
          } else {
            avail = parent.getBoundingClientRect().height;
          }
          if (!(avail > 40)) avail = window.innerHeight * 0.45;
          const prevH = el.style.fontSize;
          el.style.fontSize = '100px';
          const hEm = el.getBoundingClientRect().height / 100;
          el.style.fontSize = prevH;
          const byHeight = hEm > 0 ? (avail * 0.92) / hEm : byWidth;

          el.style.fontSize = Math.min(byWidth, byHeight) + 'px';
        };

        if (document.fonts && document.fonts.ready) document.fonts.ready.then(fit);
        addEventListener('resize', fit);
        fit();
      })();
    </script>

    <script is:inline>
      // ---- 00 loader — board 1 + spec §5 ------------------------------
      // Rapid cycle of unexplained objects, egg always first, remainder in a
      // free order because absorption is felt rather than literal. Each swap
      // is preceded by a one-beat shudder, which is the anticipation frame
      // that makes the object appear to decide. Resolves to the mark.
      (function () {
        const el = document.getElementById('loader');
        if (!el) return;
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        const objsWrap = document.getElementById('loaderObjs');
        const objs = objsWrap ? [...objsWrap.querySelectorAll('.loader__obj')] : [];
        const mark = document.getElementById('loaderMark');
        const pct = document.getElementById('loaderPct');

        const lift = () => {
          el.classList.add('done');
          document.documentElement.removeAttribute('data-loading');
          if (window.__lenis) window.__lenis.start();
        };

        if (reduce || !objs.length) { lift(); return; }

        document.documentElement.setAttribute('data-loading', '');
        if (window.__lenis) window.__lenis.stop();

        // egg first, the rest shuffled
        const rest = objs.slice(1);
        for (let i = rest.length - 1; i > 0; i--) {
          const j = Math.floor(Math.random() * (i + 1));
          [rest[i], rest[j]] = [rest[j], rest[i]];
        }
        // 9 beats over the cycle, so objects repeat — the set reads as a
        // rhythm rather than as a list being enumerated
        const seq = [objs[0]];
        for (let i = 0; i < 8; i++) seq.push(rest[i % rest.length]);

        const TOTAL = 2200;
        const t0 = performance.now();
        let step = -1, finished = false;

        const show = (i) => {
          objs.forEach((o) => o.classList.remove('on'));
          if (seq[i]) seq[i].classList.add('on');
          objsWrap.classList.remove('shudder');
          void objsWrap.offsetWidth;          // restart the animation
          objsWrap.classList.add('shudder');
        };

        const finish = () => {
          if (finished) return;
          finished = true;
          objs.forEach((o) => o.classList.remove('on'));
          if (pct) pct.textContent = '100';
          if (mark) mark.classList.add('on');
          setTimeout(lift, 620);
        };

        // Backstop: rAF does not fire in a background tab, so a loader driven
        // only by rAF strands the curtain if the site opens in one.
        const hardStop = setTimeout(finish, TOTAL + 1400);
        document.addEventListener('visibilitychange', () => {
          if (document.visibilityState === 'visible' &&
              performance.now() - t0 >= TOTAL) finish();
        });

        const tick = (now) => {
          if (finished) return;
          const p = Math.min(1, (now - t0) / TOTAL);
          if (pct) pct.textContent = String(Math.round(p * 100)).padStart(3, '0');
          // accelerate: the cycle tightens as it converges on the mark
          const eased = Math.pow(p, 0.72);
          const want = Math.min(seq.length - 1, Math.floor(eased * seq.length));
          if (want !== step) { step = want; show(want); }
          if (p < 1) requestAnimationFrame(tick);
          else { clearTimeout(hardStop); finish(); }
        };
        requestAnimationFrame(tick);
      })();
    </script>
  </body>
</html>
